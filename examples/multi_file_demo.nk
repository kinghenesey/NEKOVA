# multi_file_demo.nekova
# Demonstrates importing from other .nekova files

import "greetings.nekova"
import "utils.nekova"

# Use functions from greetings.nekova
greet("Emmanuel")
farewell("Emmanuel")
introduce("Emmanuel", 20)

# Use functions from utils.nekova
sum     = calculate(10, 20)
product = multiply(5, 6)

show "10 + 20 = {sum}"
show "5 * 6 = {product}"

adult = is_adult(20)
show "Is adult: {adult}"