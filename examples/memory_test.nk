# Test 1: Basic memory block
show "=== Test 1: Basic Memory ==="
memory user_profile:
    name = "Emmanuel"
    language = "nekova"
    version = "1.0.0"

show user_profile["name"]
show user_profile["language"]

# Test 2: Memory with a counter
show "=== Test 2: Run Counter ==="
memory stats:
    run_count = 0
    last_topic = "none"

show "Run count from memory:"
show stats["run_count"]

# Test 3: Update memory and save
show "=== Test 3: Update Memory ==="
memory settings:
    theme = "dark"
    ai_model = "gemini"
    debug = false

show "Theme:"
show settings["theme"]
show "AI Model:"
show settings["ai_model"]