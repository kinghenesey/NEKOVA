{
  "Think as text": {
    "prefix": [
      "think",
      "tk"
    ],
    "body": [
      "think \"${1:prompt}\" as text"
    ],
    "description": "AI think \u2014 text response"
  },
  "Think as json": {
    "prefix": "thinkj",
    "body": [
      "think \"${1:prompt}\" as json"
    ],
    "description": "AI think \u2014 JSON response"
  },
  "Think as list": {
    "prefix": "thinkl",
    "body": [
      "think \"${1:prompt}\" as list"
    ],
    "description": "AI think \u2014 list response"
  },
  "Think captured": {
    "prefix": "thinkcap",
    "body": [
      "${1:result} = think \"${2:prompt}\" as ${3:text}"
    ],
    "description": "Capture AI think result"
  },
  "Remember": {
    "prefix": "rem",
    "body": [
      "remember \"${1:key}\" as \"${2:value}\""
    ],
    "description": "Store a value in AI memory"
  },
  "Recall": {
    "prefix": "rec",
    "body": [
      "recall \"${1:key}\""
    ],
    "description": "Recall a value from AI memory"
  },
  "Task definition": {
    "prefix": "task",
    "body": [
      "task ${1:name}(${2:args}):",
      "    ${3:pass}"
    ],
    "description": "Define a NEKOVA task (function)"
  },
  "Async task": {
    "prefix": "atask",
    "body": [
      "async task ${1:name}(${2:args}):",
      "    ${3:pass}"
    ],
    "description": "Define an async task"
  },
  "If statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${2:pass}"
    ],
    "description": "If statement"
  },
  "If else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}:",
      "    ${2:pass}",
      "else:",
      "    ${3:pass}"
    ],
    "description": "If / else statement"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    ${3:show item}"
    ],
    "description": "For loop"
  },
  "Repeat loop": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:5}:",
      "    ${2:pass}"
    ],
    "description": "Repeat N times"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition}:",
      "    ${2:pass}"
    ],
    "description": "While loop"
  },
  "Match statement": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    when \"${2:case1}\":  ${3:pass}",
      "    when \"${4:case2}\":  ${5:pass}",
      "    else:               ${6:pass}"
    ],
    "description": "Pattern matching"
  },
  "Object class": {
    "prefix": "obj",
    "body": [
      "object ${1:Name}:",
      "    init(${2:self, args}):",
      "        self.${3:attr} = ${3:attr}",
      "",
      "    task ${4:method}(self):",
      "        ${5:pass}"
    ],
    "description": "Define a NEKOVA object (class)"
  },
  "Object with extends": {
    "prefix": "objext",
    "body": [
      "object ${1:Child} extends ${2:Parent}:",
      "    init(${3:args}):",
      "        super(${4:args})",
      "",
      "    task ${5:method}(self):",
      "        ${6:pass}"
    ],
    "description": "Object with inheritance"
  },
  "New instance": {
    "prefix": "new",
    "body": [
      "${1:instance} = new ${2:ClassName}(${3:args})"
    ],
    "description": "Create a new object instance"
  },
  "Route GET": {
    "prefix": "routeg",
    "body": [
      "route GET \"${1:/path}\":",
      "    return \"${2:Hello!}\""
    ],
    "description": "GET route handler"
  },
  "Route POST": {
    "prefix": "routep",
    "body": [
      "route POST \"${1:/path}\":",
      "    ${2:pass}"
    ],
    "description": "POST route handler"
  },
  "Serve": {
    "prefix": "serve",
    "body": [
      "serve port: ${1:8080}"
    ],
    "description": "Start NEKOVA web server"
  },
  "DB connect": {
    "prefix": "dbcon",
    "body": [
      "let ${1:db} = connect(\"${2:myapp.db}\")"
    ],
    "description": "Connect to SQLite database"
  },
  "DB create table": {
    "prefix": "dbcreate",
    "body": [
      "${1:db}.create(\"${2:table}\", \"${3:col text, col2 integer}\")"
    ],
    "description": "Create a database table"
  },
  "DB insert": {
    "prefix": "dbins",
    "body": [
      "${1:db}.insert(\"${2:table}\", ${3:data})"
    ],
    "description": "Insert into database"
  },
  "DB query": {
    "prefix": "dbq",
    "body": [
      "let ${1:rows} = ${2:db}.query(\"${3:table}\")"
    ],
    "description": "Query database table"
  },
  "Use module": {
    "prefix": "use",
    "body": [
      "use ${1:json}"
    ],
    "description": "Import stdlib module"
  },
  "Try catch": {
    "prefix": "try",
    "body": [
      "try:",
      "    ${1:pass}",
      "catch ${2:e}:",
      "    show ${2:e}"
    ],
    "description": "Try / catch block"
  },
  "Pipeline": {
    "prefix": "pipeline",
    "body": [
      "pipeline ${1:name}:",
      "    collect \"${2:input}\"",
      "    process with ai",
      "    generate ${3:report}",
      "    save to ${4:database}"
    ],
    "description": "Neural pipeline block"
  },
  "Parallel": {
    "prefix": "parallel",
    "body": [
      "autonomous parallel:",
      "    think \"${1:prompt 1}\" as text",
      "    think \"${2:prompt 2}\" as text"
    ],
    "description": "Parallel AI execution"
  },
  "Prompt block": {
    "prefix": [
      "prompt",
      "promptdef"
    ],
    "body": [
      "prompt ${1:name}(${2:text}, ${3:style}=\"${4:professional}\"):",
      "    \"\"\"",
      "    ${5:Summarize the following in a {${3:style}} tone.}",
      "    ${6:Text: {${2:text}}}",
      "    \"\"\""
    ],
    "description": "Named, composable prompt definition (Phase 21)"
  },
  "Retry with fallback": {
    "prefix": "retry",
    "body": [
      "retry ${1:3} times with ${2|exponential,linear|} backoff:",
      "    ${3:let result = think \"${4:analyse this}\" as json}",
      "fallback:",
      "    ${5:let result = {error: \"unavailable\"}}"
    ],
    "description": "Retry block with backoff and fallback clause"
  },
  "Retry simple": {
    "prefix": "retrys",
    "body": [
      "retry ${1:3} times:",
      "    ${2:pass}"
    ],
    "description": "Retry block with no backoff or fallback"
  },
  "Observe block": {
    "prefix": "observe",
    "body": [
      "observe \"${1:label}\" with tags {${2:user}: ${3:user_id}}:",
      "    ${4:pass}"
    ],
    "description": "Tag and trace a block of execution (Phase 22)"
  },
  "Mock think": {
    "prefix": "mock",
    "body": [
      "mock think as \"${1:response}\""
    ],
    "description": "Stub think inside a test block \u2014 no real AI call (Phase 22)"
  },
  "Pipe chain": {
    "prefix": "pipe",
    "body": [
      "let ${1:result} = ${2:data} |> ${3:parse()} |> ${4:filter()} |> ${5:sort()}"
    ],
    "description": "Chain transformations left to right with |> (Phase 22)"
  },
  "Sandbox": {
    "prefix": "sandbox",
    "body": [
      "sandbox ${1:strict}:",
      "    ${2:pass}"
    ],
    "description": "Sandbox block"
  },
  "Agent pipeline": {
    "prefix": "agent",
    "body": [
      "\"${1:input}\" -> ${2:researcher} -> ${3:writer}"
    ],
    "description": "Chain AI agents"
  },
  "Show": {
    "prefix": "show",
    "body": [
      "show \"${1:message}\""
    ],
    "description": "Print to output"
  },
  "F-string": {
    "prefix": "fs",
    "body": [
      "f\"{${1:variable}}\""
    ],
    "description": "NEKOVA f-string interpolation"
  },
  "Let variable": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${2:value}"
    ],
    "description": "Declare a variable with let"
  },
  "Model switch": {
    "prefix": "model",
    "body": [
      "model \"${1:claude}\""
    ],
    "description": "Switch AI provider"
  },
  "NEKOVA file header": {
    "prefix": "header",
    "body": [
      "# ${1:Project Name} \u2014 built with NEKOVA",
      "# Built by ${2:SYNEKCOT Tech}",
      "",
      "${3:show \"Hello, NEKOVA!\"}"
    ],
    "description": "Standard NEKOVA file header"
  },
  "Assert statement": {
    "prefix": "assert",
    "body": [
      "assert ${1:condition}, \"${2:message}\""
    ],
    "description": "Assert a condition with optional message"
  },
  "Raise error": {
    "prefix": "raise",
    "body": [
      "raise ${1:\"error message\"}"
    ],
    "description": "Raise an error"
  },
  "Ternary expression": {
    "prefix": "ternary",
    "body": [
      "${1:value} if ${2:condition} else ${3:other}"
    ],
    "description": "Inline ternary expression"
  },
  "Try catch finally": {
    "prefix": "tcf",
    "body": [
      "try:",
      "\t${1:# code}",
      "catch ${2:err}:",
      "\t${3:show err}",
      "finally:",
      "\t${4:# cleanup}"
    ],
    "description": "Try / catch / finally block"
  },
  "Speak": {
    "prefix": "speak",
    "body": [
      "speak \"${1:Hello, world!}\""
    ],
    "description": "Text-to-speech output"
  },
  "Listen": {
    "prefix": "listen",
    "body": [
      "let ${1:response} = listen \"${2:Say something}\""
    ],
    "description": "Speech-to-text input"
  },
  "Every loop": {
    "prefix": "every",
    "body": [
      "every ${1:5} s ${2:10} times:",
      "\t${3:show \"tick\"}"
    ],
    "description": "Scheduled repeated execution"
  },
  "Test block": {
    "prefix": "test",
    "body": [
      "test \"${1:test name}\":",
      "\texpect ${2:1 + 1} == ${3:2}"
    ],
    "description": "Built-in test block with expect"
  },
  "Expect": {
    "prefix": "expect",
    "body": [
      "expect ${1:expression} == ${2:expected}"
    ],
    "description": "Assertion inside a test block"
  },
  "Imagine": {
    "prefix": "imagine",
    "body": [
      "let ${1:img} = imagine \"${2:a futuristic city}\" as ${3:url}"
    ],
    "description": "AI image generation"
  },
  "Shape definition": {
    "prefix": "shape",
    "body": [
      "shape ${1:Name}:",
      "\t${2:field} ${3:str}",
      "\t${4:value} ${5:int} = ${6:0}"
    ],
    "description": "Data schema / validated struct"
  },
  "Watch file": {
    "prefix": "watch",
    "body": [
      "watch \"${1:config.toml}\":",
      "\t${2:show \"file changed\"}"
    ],
    "description": "File watcher \u2014 runs body when file changes"
  },
  "Generator task": {
    "prefix": "taskgen",
    "body": [
      "task ${1:generate}(${2:n}):",
      "\tlet i = 0",
      "\twhile i < ${2:n}:",
      "\t\tyield i",
      "\t\tlet i = i + 1",
      "",
      "for ${3:x} in ${1:generate}(${4:10}):",
      "\tshow ${3:x}"
    ],
    "description": "Generator task with yield"
  },
  "Decorator": {
    "prefix": "decorator",
    "body": [
      "@${1:decorator}",
      "task ${2:name}(${3:args}):",
      "\t${4:return args}"
    ],
    "description": "Decorator applied to a task"
  },
  "Error type": {
    "prefix": "error",
    "body": [
      "error ${1:NetworkError}:",
      "\tmessage str",
      "\tcode int = ${2:500}"
    ],
    "description": "Custom error type definition"
  },
  "Typed task": {
    "prefix": "taskt",
    "body": [
      "task ${1:name}(${2:a}: ${3:int}, ${4:b}: ${5:int}) -> ${6:int}:",
      "\treturn ${2:a} + ${4:b}"
    ],
    "description": "Task with type hints and return type"
  },
  "Class definition": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "\t${2:field}: ${3:str}",
      "\tinit(${2:field}: ${3:str}):",
      "\t\tself.${2:field} = ${2:field}",
      "\tfunc ${4:method}():",
      "\t\treturn self.${2:field}"
    ],
    "description": "Class definition (alias for object)"
  },
  "Use math": {
    "prefix": "usemath",
    "body": [
      "use math",
      "show clamp(${1:value}, ${2:0}, ${3:100})"
    ],
    "description": "Import NEKOVA math stdlib"
  },
  "Use string": {
    "prefix": "usestring",
    "body": [
      "use string",
      "show pad_left(\"${1:text}\", ${2:10})"
    ],
    "description": "Import NEKOVA string stdlib"
  },
  "Use file": {
    "prefix": "usefile",
    "body": [
      "use file",
      "let content = read(\"${1:file.txt}\")",
      "show content"
    ],
    "description": "Import NEKOVA file stdlib"
  },
  "Use date": {
    "prefix": "usedate",
    "body": [
      "use date",
      "show today()",
      "show day_of_week(today())"
    ],
    "description": "Import NEKOVA date stdlib"
  },
  "Sandbox strict": {
    "prefix": "sandboxs",
    "body": [
      "sandbox strict:",
      "\t${1:# safe code only}",
      "show sandbox_result[\"safe\"]"
    ],
    "description": "Strict sandbox block \u2014 blocks all file/system access"
  },
  "Sandbox relaxed": {
    "prefix": "sandboxr",
    "body": [
      "sandbox relaxed:",
      "\t${1:# read-only file access allowed}"
    ],
    "description": "Relaxed sandbox \u2014 allows read-only file operations"
  },
  "Sandbox run": {
    "prefix": "sandboxrun",
    "body": [
      "let ${1:result} = sandbox_run(\"${2:show 42}\", \"${3:strict}\")",
      "show ${1:result}[\"output\"]",
      "show ${1:result}[\"safe\"]"
    ],
    "description": "Run NEKOVA code in a sandbox programmatically"
  },
  "Const binding": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value}"
    ],
    "description": "Declare an immutable const binding (Phase 24)"
  },
  "Enum definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name}: ${2:MEMBER_ONE}, ${3:MEMBER_TWO}, ${4:MEMBER_THREE}"
    ],
    "description": "Define a first-class enum (Phase 24)"
  },
  "List destructure": {
    "prefix": "letlist",
    "body": [
      "let [${1:first}, ...${2:rest}] = ${3:my_list}"
    ],
    "description": "Destructure a list with a rest capture (Phase 24)"
  },
  "Tuple destructure": {
    "prefix": "lettuple",
    "body": [
      "let (${1:a}, ${2:b}) = ${3:pair}"
    ],
    "description": "Destructure a tuple/pair (Phase 24)"
  },
  "Dict destructure": {
    "prefix": "letdict",
    "body": [
      "let {${1:name}, ${2:age}} = ${3:my_dict}"
    ],
    "description": "Destructure a dict by key (Phase 24)"
  },
  "Optional chaining": {
    "prefix": "optchain",
    "body": [
      "${1:value}?.${2:property}"
    ],
    "description": "Optional chaining \u2014 short-circuits to null (Phase 24)"
  },
  "Set literal": {
    "prefix": "setlit",
    "body": [
      "let ${1:name} = {${2:1, 2, 3}}"
    ],
    "description": "Define a set literal (Phase 24)"
  },
  "Keyword arguments call": {
    "prefix": "callkw",
    "body": [
      "${1:task_name}(${2:param}=${3:value})"
    ],
    "description": "Call a task with keyword arguments (Phase 24)"
  },
  "Think with inline error handling": {
    "prefix": "thinkerr",
    "body": [
      "let ${1:result} = think \"${2:prompt}\" when error: ${3:\"fallback\"}"
    ],
    "description": "think with inline error fallback (Phase 23)"
  },
  "Task docstring": {
    "prefix": "taskdoc",
    "body": [
      "task ${1:name}(${2:args}):",
      "    \"\"\"${3:Describe what this task does.}\"\"\"",
      "    ${4:pass}"
    ],
    "description": "Task with a docstring (Phase 23)"
  },
  "Converse block": {
    "prefix": "converse",
    "body": [
      "converse:",
      "    think \"${1:ask a clarifying question about {topic}}\"",
      "    listen",
      "    think \"${2:respond based on what they said}\""
    ],
    "description": "Multi-turn AI dialogue block (Phase 25)"
  },
  "Think as shape": {
    "prefix": "thinkshape",
    "body": [
      "let ${1:result} = think \"${2:extract from: {text}}\" as ${3:ShapeName}"
    ],
    "description": "think using a defined shape as output format (Phase 25)"
  },
  "Think with budget": {
    "prefix": "thinkbudget",
    "body": [
      "let ${1:result} = think \"${2:prompt}\" with budget: ${3:500}"
    ],
    "description": "think with a token budget cap (Phase 25)"
  },
  "Think using model": {
    "prefix": "thinkmodel",
    "body": [
      "let ${1:result} = think \"${2:prompt}\" using \"${3:claude-sonnet}\""
    ],
    "description": "think with explicit model selection (Phase 25)"
  },
  "Imagine as file": {
    "prefix": "imaginefile",
    "body": [
      "let ${1:image} = imagine \"${2:a description}\" as file"
    ],
    "description": "imagine with local caching (Phase 25)"
  },
  "AI usage check": {
    "prefix": "aiusage",
    "body": [
      "show ai_usage()"
    ],
    "description": "Show cumulative AI call/token usage (Phase 25)"
  }
}