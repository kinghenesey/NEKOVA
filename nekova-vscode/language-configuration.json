{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\""
        },
        {
            "open": "'",
            "close": "'"
        }
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(if|else|elif|repeat|while|for|task|try|catch|finally|object|route|pipeline|sandbox|autonomous|memory|match|when|async|retry|fallback|every|watch|prompt)\\b.*:\\s*$",
        "decreaseIndentPattern": "^\\s*(else|elif|catch|finally|fallback)\\b"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(if|else|elif|repeat|while|for|task|try|catch|object|route|pipeline|sandbox|autonomous|match|when|async)\\b.*:\\s*$",
            "action": {
                "indent": "indent"
            }
        }
    ],
    "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}