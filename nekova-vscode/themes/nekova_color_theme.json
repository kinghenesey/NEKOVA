{
  "name": "NEKOVA Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#141110",
    "editor.foreground": "#E8DCC8",
    "editorCursor.foreground": "#E8B84B",
    "editor.lineHighlightBackground": "#1C1815",
    "editor.selectionBackground": "#8C1C1C55",
    "editorLineNumber.foreground": "#5A5049",
    "editorLineNumber.activeForeground": "#E8B84B",
    "editorIndentGuide.background": "#242019",
    "editorIndentGuide.activeBackground": "#3A322A",
    "editorWhitespace.foreground": "#2A241E",

    "activityBar.background": "#0D0B0A",
    "activityBar.foreground": "#E8B84B",
    "activityBarBadge.background": "#D4213A",
    "activityBarBadge.foreground": "#F5EFE4",

    "sideBar.background": "#181513",
    "sideBar.foreground": "#C9BCA6",
    "sideBarTitle.foreground": "#E8B84B",
    "sideBarSectionHeader.background": "#1C1815",

    "statusBar.background": "#D4213A",
    "statusBar.foreground": "#F5EFE4",
    "statusBar.noFolderBackground": "#8C1C1C",
    "statusBar.debuggingBackground": "#8C1C1C",

    "titleBar.activeBackground": "#0D0B0A",
    "titleBar.activeForeground": "#E8B84B",
    "titleBar.inactiveBackground": "#0D0B0A",
    "titleBar.inactiveForeground": "#7A6F60",

    "tab.activeBackground": "#141110",
    "tab.activeForeground": "#F0C24B",
    "tab.inactiveBackground": "#0D0B0A",
    "tab.inactiveForeground": "#7A6F60",
    "tab.activeBorderTop": "#D4213A",
    "tab.border": "#0D0B0A",

    "panel.background": "#141110",
    "panel.border": "#2A241E",

    "terminal.background": "#141110",
    "terminal.foreground": "#E8DCC8",
    "terminal.ansiRed": "#E8433A",
    "terminal.ansiYellow": "#E8B84B",
    "terminal.ansiGreen": "#C9A227",
    "terminal.ansiBlue": "#C97A6D",
    "terminal.ansiMagenta": "#D4213A",
    "terminal.ansiCyan": "#E8CD8A",

    "button.background": "#D4213A",
    "button.foreground": "#F5EFE4",
    "button.hoverBackground": "#E8433A",

    "focusBorder": "#E8B84B",
    "badge.background": "#D4213A",
    "badge.foreground": "#F5EFE4"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment.line.number-sign.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#7A6F60" }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.nekova",
        "string.quoted.single.nekova",
        "string.quoted.triple.double.nekova",
        "string.quoted.triple.single.nekova"
      ],
      "settings": { "foreground": "#F0C24B" }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.section.interpolation.begin.nekova",
        "punctuation.section.interpolation.end.nekova",
        "meta.interpolation.nekova"
      ],
      "settings": { "foreground": "#E8433A" }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric.integer.nekova",
        "constant.numeric.float.nekova",
        "constant.numeric.hex.nekova",
        "constant.numeric.scientific.nekova"
      ],
      "settings": { "foreground": "#E8B84B" }
    },
    {
      "name": "true / false / null",
      "scope": ["constant.language.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#E8433A" }
    },

    {
      "name": "AI-native keywords — think, speak, listen, imagine, watch, every",
      "scope": ["keyword.other.ai.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#FFD86B" }
    },

    {
      "name": "Control flow keywords",
      "scope": ["keyword.control.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#E8433A" }
    },
    {
      "name": "Declaration keywords",
      "scope": ["keyword.declaration.nekova"],
      "settings": { "foreground": "#D4A72C" }
    },
    {
      "name": "Class keywords",
      "scope": ["keyword.other.class.nekova"],
      "settings": { "foreground": "#D4213A" }
    },
    {
      "name": "Sandbox / security keywords",
      "scope": ["keyword.other.sandbox.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#8C1C1C" }
    },
    {
      "name": "Memory keywords — remember, recall, forget",
      "scope": ["keyword.other.memory.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#E8CD8A" }
    },
    {
      "name": "Test keywords",
      "scope": ["keyword.other.test.nekova"],
      "settings": { "foreground": "#E8CD8A" }
    },
    {
      "name": "Web / DB keywords",
      "scope": ["keyword.other.web.nekova", "keyword.other.db.nekova"],
      "settings": { "foreground": "#C97A6D" }
    },

    {
      "name": "Operators",
      "scope": [
        "keyword.operator.nekova",
        "keyword.operator.arithmetic.nekova",
        "keyword.operator.assignment.nekova",
        "keyword.operator.augmented-assignment.nekova",
        "keyword.operator.comparison.nekova",
        "keyword.operator.logical.nekova",
        "keyword.operator.floor-division.nekova",
        "keyword.operator.power.nekova",
        "keyword.operator.range.nekova"
      ],
      "settings": { "foreground": "#E8DCC8" }
    },
    {
      "name": "Pipe and AI-pipeline operators — |> and ->",
      "scope": ["keyword.operator.pipe.nekova", "keyword.operator.pipeline.ai.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#F0C24B" }
    },

    {
      "name": "Function / task names",
      "scope": ["entity.name.function.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#F0C24B" }
    },
    {
      "name": "Decorators",
      "scope": ["entity.name.function.decorator.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#D4213A" }
    },
    {
      "name": "Namespaces / modules",
      "scope": ["entity.name.namespace.nekova"],
      "settings": { "foreground": "#D4A72C" }
    },

    {
      "name": "self",
      "scope": ["variable.language.self.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#C97A6D" }
    },
    {
      "name": "Variables",
      "scope": ["variable.other.nekova"],
      "settings": { "foreground": "#E8DCC8" }
    },

    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin.nekova"],
      "settings": { "foreground": "#E8B84B" }
    },
    {
      "name": "Types / shapes",
      "scope": ["support.type.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#A67C2E" }
    },

    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape.nekova"],
      "settings": { "foreground": "#E8433A" }
    },
    {
      "name": "String delimiters",
      "scope": [
        "punctuation.definition.string.begin.nekova",
        "punctuation.definition.string.end.nekova"
      ],
      "settings": { "foreground": "#A67C2E" }
    }
  ]
}