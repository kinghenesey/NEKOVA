{
  "name": "NEKOVA Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0D100E",
    "editor.foreground": "#FFFFFF",
    "editorCursor.foreground": "#3DDC84",
    "editor.lineHighlightBackground": "#161B17",
    "editor.selectionBackground": "#2ECC7140",
    "editorLineNumber.foreground": "#3D6B4D",
    "editorLineNumber.activeForeground": "#3DDC84",
    "editorIndentGuide.background": "#1A211C",
    "editorIndentGuide.activeBackground": "#2ECC7155",
    "editorWhitespace.foreground": "#1A211C",

    "editorError.foreground": "#FF5C5C",
    "editorError.border": "#FF5C5C",
    "editorWarning.foreground": "#E8B84B",
    "editorInfo.foreground": "#3DDC84",
    "problemsErrorIcon.foreground": "#FF5C5C",
    "problemsWarningIcon.foreground": "#E8B84B",
    "list.errorForeground": "#FF5C5C",
    "list.warningForeground": "#E8B84B",
    "editorGutter.modifiedBackground": "#3DDC84",
    "editorGutter.addedBackground": "#3DDC84",
    "editorGutter.deletedBackground": "#FF5C5C",

    "activityBar.background": "#0A0C0B",
    "activityBar.foreground": "#FFFFFF",
    "activityBarBadge.background": "#2ECC71",
    "activityBarBadge.foreground": "#0A0C0B",

    "sideBar.background": "#0D100E",
    "sideBar.foreground": "#FFFFFF",
    "sideBarTitle.foreground": "#3DDC84",
    "sideBarSectionHeader.background": "#161B17",

    "statusBar.background": "#1F7A4C",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#0A0C0B",
    "statusBar.debuggingBackground": "#E8B84B",
    "statusBar.debuggingForeground": "#0D100E",

    "titleBar.activeBackground": "#0A0C0B",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#0A0C0B",
    "titleBar.inactiveForeground": "#3DDC84AA",

    "tab.activeBackground": "#0D100E",
    "tab.activeForeground": "#FFFFFF",
    "tab.inactiveBackground": "#0A0C0B",
    "tab.inactiveForeground": "#3DDC84AA",
    "tab.activeBorderTop": "#2ECC71",
    "tab.border": "#0A0C0B",

    "panel.background": "#0D100E",
    "panel.border": "#1A211C",

    "terminal.background": "#0D100E",
    "terminal.foreground": "#FFFFFF",
    "terminal.ansiRed": "#FF5C5C",
    "terminal.ansiYellow": "#E8B84B",
    "terminal.ansiGreen": "#3DDC84",
    "terminal.ansiBlue": "#3DDC84",
    "terminal.ansiMagenta": "#FFFFFF",
    "terminal.ansiCyan": "#A8F0C6",

    "button.background": "#2ECC71",
    "button.foreground": "#0D100E",
    "button.hoverBackground": "#3DDC84",

    "focusBorder": "#2ECC71",
    "badge.background": "#2ECC71",
    "badge.foreground": "#0D100E"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment.line.number-sign.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#3D6B4D" }
    },
    {
      "name": "Strings",
      "scope": [
        "string.quoted.double.nekova",
        "string.quoted.single.nekova",
        "string.quoted.triple.double.nekova",
        "string.quoted.triple.single.nekova"
      ],
      "settings": { "foreground": "#A8F0C6" }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.section.interpolation.begin.nekova",
        "punctuation.section.interpolation.end.nekova",
        "meta.interpolation.nekova"
      ],
      "settings": { "foreground": "#3DDC84" }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric.integer.nekova",
        "constant.numeric.float.nekova",
        "constant.numeric.hex.nekova",
        "constant.numeric.scientific.nekova"
      ],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "name": "true / false / null",
      "scope": ["constant.language.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#3DDC84" }
    },

    {
      "name": "AI-native keywords — think, speak, listen, imagine, watch, every",
      "scope": ["keyword.other.ai.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#3DDC84" }
    },

    {
      "name": "Control flow keywords",
      "scope": ["keyword.control.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#FFFFFF" }
    },
    {
      "name": "Declaration keywords",
      "scope": ["keyword.declaration.nekova"],
      "settings": { "foreground": "#2ECC71" }
    },
    {
      "name": "Class keywords",
      "scope": ["keyword.other.class.nekova"],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "name": "Sandbox / security keywords",
      "scope": ["keyword.other.sandbox.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#3DDC84" }
    },
    {
      "name": "Memory keywords — remember, recall, forget",
      "scope": ["keyword.other.memory.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#A8F0C6" }
    },
    {
      "name": "Test keywords",
      "scope": ["keyword.other.test.nekova"],
      "settings": { "foreground": "#A8F0C6" }
    },
    {
      "name": "Web / DB keywords",
      "scope": ["keyword.other.web.nekova", "keyword.other.db.nekova"],
      "settings": { "foreground": "#FFFFFF" }
    },

    {
      "name": "Operators",
      "scope": [
        "keyword.operator.nekova",
        "keyword.operator.arithmetic.nekova",
        "keyword.operator.assignment.nekova",
        "keyword.operator.augmented-assignment.nekova",
        "keyword.operator.comparison.nekova",
        "keyword.operator.logical.nekova",
        "keyword.operator.floor-division.nekova",
        "keyword.operator.power.nekova",
        "keyword.operator.range.nekova"
      ],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "name": "Pipe and AI-pipeline operators — |> and ->",
      "scope": ["keyword.operator.pipe.nekova", "keyword.operator.pipeline.ai.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#3DDC84" }
    },

    {
      "name": "Function / task names",
      "scope": ["entity.name.function.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#FFFFFF" }
    },
    {
      "name": "Decorators",
      "scope": ["entity.name.function.decorator.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#2ECC71" }
    },
    {
      "name": "Namespaces / modules",
      "scope": ["entity.name.namespace.nekova"],
      "settings": { "foreground": "#A8F0C6" }
    },

    {
      "name": "self",
      "scope": ["variable.language.self.nekova"],
      "settings": { "fontStyle": "italic", "foreground": "#A8F0C6" }
    },
    {
      "name": "Variables",
      "scope": ["variable.other.nekova"],
      "settings": { "foreground": "#FFFFFF" }
    },

    {
      "name": "Built-in functions",
      "scope": ["support.function.builtin.nekova"],
      "settings": { "foreground": "#3DDC84" }
    },
    {
      "name": "Types / shapes",
      "scope": ["support.type.nekova"],
      "settings": { "fontStyle": "bold", "foreground": "#2ECC71" }
    },

    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape.nekova"],
      "settings": { "foreground": "#3DDC84" }
    },
    {
      "name": "String delimiters",
      "scope": [
        "punctuation.definition.string.begin.nekova",
        "punctuation.definition.string.end.nekova"
      ],
      "settings": { "foreground": "#3DDC84" }
    }
  ]
}