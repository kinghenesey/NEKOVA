{
  "name": "nekova-lang",
  "displayName": "NEKOVA - AI Native Programming Language",
  "description": "Syntax highlighting for the NEKOVA AI-Native Programming Language — think, pipelines, vision, voice, memory, sandbox and more. Built by SYNEKCOT Tech.",
  "version": "1.1.0",
  "publisher": "emmanuel-king-christopher",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nekova",
    "ai",
    "programming language",
    "nigeria",
    "synekcot",
    "syntax highlighting",
    "think",
    "neural pipeline",
    "multimodal",
    "agent",
    "connected forge"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kinghenesey/NEKOVA"
  },
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "nekova",
        "aliases": [
          "NEKOVA",
          "nekova"
        ],
        "extensions": [
          ".nk"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nekova",
        "scopeName": "source.nekova",
        "path": "./syntaxes/nekova.tmLanguage.json"
      }
    ],
    "themes": []
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nekova",
    "workspaceContains:**/*.nk"
  ],
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.0.0"
  }
}
