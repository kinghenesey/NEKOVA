{
  "name": "NEKOVA",
  "scopeName": "source.nekova",
  "fileTypes": [
    "nk"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#fstrings"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#think_types"
    },
    {
      "include": "#keywords_control"
    },
    {
      "include": "#keywords_declaration"
    },
    {
      "include": "#keywords_ai"
    },
    {
      "include": "#keywords_web"
    },
    {
      "include": "#keywords_db"
    },
    {
      "include": "#keywords_class"
    },
    {
      "include": "#keywords_memory"
    },
    {
      "include": "#keywords_logic"
    },
    {
      "include": "#stdlib_modules"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#keywords_sandbox"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.hash.nekova",
      "match": "#.*$"
    },
    "fstrings": {
      "name": "string.quoted.double.nekova meta.fstring.nekova",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        {
          "name": "meta.interpolation.nekova",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#variables"
            }
          ]
        },
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nekova",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.nekova",
              "match": "\\{([a-zA-Z_][a-zA-Z0-9_.]*)\\}",
              "captures": {
                "1": {
                  "name": "variable.other.nekova"
                }
              }
            },
            {
              "name": "constant.character.escape.nekova",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nekova",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nekova",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "think_types": {
      "comment": "as <type> after think",
      "match": "\\bas\\s+(text|json|list|bool|schema)\\b",
      "captures": {
        "0": {
          "name": "keyword.ai.nekova"
        },
        "1": {
          "name": "support.type.nekova"
        }
      }
    },
    "keywords_control": {
      "name": "keyword.control.nekova",
      "match": "\\b(if|else|elif|repeat|while|for|in|not\\s+in|return|break|continue|try|catch|finally|raise|pass|assert|match|when|yield)\\b"
    },
    "keywords_declaration": {
      "name": "keyword.declaration.nekova",
      "match": "\\b(task|use|import|from|let|async|await|pipeline|sandbox|strict|relaxed|class|object|error|shape|every|watch|test|expect|imagine|speak|listen|global|yield)\\b"
    },
    "keywords_ai": {
      "name": "keyword.ai.nekova",
      "match": "\\b(think|model|autonomous|parallel|collect|generate|process|save|with|run|stream)\\b"
    },
    "keywords_web": {
      "name": "keyword.web.nekova",
      "match": "\\b(route|serve|GET|POST|PUT|DELETE|PATCH|request|response|port)\\b"
    },
    "keywords_db": {
      "name": "keyword.db.nekova",
      "match": "\\b(connect|query|insert|create|update|delete)\\b"
    },
    "keywords_class": {
      "name": "keyword.class.nekova",
      "match": "\\b(object|class|init|self|new|extends|super)\\b"
    },
    "keywords_memory": {
      "name": "keyword.memory.nekova",
      "match": "\\b(remember|recall|forget|memory)\\b"
    },
    "keywords_logic": {
      "name": "keyword.operator.logical.nekova",
      "match": "\\b(and|or|not|is|as|in)\\b"
    },
    "stdlib_modules": {
      "name": "entity.name.namespace.nekova",
      "match": "(?<=use )\\b(math|string|file|date|text|files|datetime|collections|json|env|uuid|crypto|ai|agents|ui|web|database|vision|audio|payments|auth)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.nekova",
      "match": "\\b(show|ask|sleep|clear|type_of|length|range|to_text|to_number|to_list|random_num|sqrt|floor|ceil|log|sin|cos|tan|pow|len|str|int|float|bool|abs|round|min|max|sum|sorted|reversed|list|dict|print|file_read|file_write|file_exists|file_delete|date_now|date_today|sandbox_run|clamp|lerp|factorial|fibonacci|gcd|lcm|average|product|pad_left|pad_right|truncate|reverse|capitalize|is_palindrome|is_even|is_odd)\\b"
    },
    "booleans": {
      "name": "constant.language.nekova",
      "match": "\\b(true|false|null|none|True|False|None)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nekova",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.nekova",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.nekova",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.nekova",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.arithmetic.nekova",
          "match": "(\\+|-|\\*\\*|\\*|/|%)"
        },
        {
          "name": "keyword.operator.pipeline.nekova",
          "match": "->"
        },
        {
          "name": "keyword.operator.walrus.nekova",
          "match": ":="
        },
        {
          "name": "keyword.operator.decorator.nekova",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "keyword.operator.arrow.nekova",
          "match": "->"
        }
      ]
    },
    "functions": {
      "name": "entity.name.function.nekova",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
    },
    "variables": {
      "name": "variable.other.nekova",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
    },
    "keywords_sandbox": {
      "name": "keyword.sandbox.nekova",
      "match": "\\b(sandbox|strict|relaxed|sandbox_run|sandbox_result)\\b"
    }
  }
}