{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NEKOVA",
  "scopeName": "source.nekova",
  "fileTypes": [
    "nk"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#fstrings_double"
    },
    {
      "include": "#fstrings_single"
    },
    {
      "include": "#strings_triple_double"
    },
    {
      "include": "#strings_triple_single"
    },
    {
      "include": "#strings_double"
    },
    {
      "include": "#strings_single"
    },
    {
      "include": "#think_as_clause"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#prompt_definition"
    },
    {
      "include": "#keywords_ai"
    },
    {
      "include": "#keywords_control"
    },
    {
      "include": "#keywords_declaration"
    },
    {
      "include": "#keywords_class"
    },
    {
      "include": "#keywords_memory"
    },
    {
      "include": "#keywords_web"
    },
    {
      "include": "#keywords_db"
    },
    {
      "include": "#keywords_sandbox"
    },
    {
      "include": "#keywords_logic"
    },
    {
      "include": "#keywords_test"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#task_definition"
    },
    {
      "include": "#function_calls"
    },
    {
      "include": "#stdlib_modules"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#self_keyword"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.nekova",
      "match": "#.*$"
    },
    "fstrings_double": {
      "name": "string.quoted.double.nekova",
      "begin": "f\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nekova"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nekova"
        }
      },
      "patterns": [
        {
          "name": "meta.interpolation.nekova",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.nekova"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.nekova"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#function_calls"
            },
            {
              "include": "#variables"
            }
          ]
        },
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "fstrings_single": {
      "name": "string.quoted.single.nekova",
      "begin": "f'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nekova"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nekova"
        }
      },
      "patterns": [
        {
          "name": "meta.interpolation.nekova",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.nekova"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.nekova"
            }
          },
          "patterns": [
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#function_calls"
            },
            {
              "include": "#variables"
            }
          ]
        },
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "strings_triple_double": {
      "name": "string.quoted.triple.double.nekova",
      "begin": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nekova"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nekova"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "strings_triple_single": {
      "name": "string.quoted.triple.single.nekova",
      "begin": "'''",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nekova"
        }
      },
      "end": "'''",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nekova"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "strings_double": {
      "name": "string.quoted.double.nekova",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nekova"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nekova"
        }
      },
      "patterns": [
        {
          "name": "meta.interpolation.nekova",
          "match": "\\{([a-zA-Z_][a-zA-Z0-9_.]*)\\}",
          "captures": {
            "1": {
              "name": "variable.other.nekova"
            }
          }
        },
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "strings_single": {
      "name": "string.quoted.single.nekova",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nekova"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nekova"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nekova",
          "match": "\\\\."
        }
      ]
    },
    "think_as_clause": {
      "match": "\\b(as)\\s+(text|json|list|bool|number|schema)\\b",
      "captures": {
        "1": {
          "name": "keyword.operator.nekova"
        },
        "2": {
          "name": "support.type.nekova"
        }
      }
    },
    "decorators": {
      "name": "entity.name.function.decorator.nekova",
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "prompt_definition": {
      "name": "keyword.declaration.nekova",
      "match": "\\b(prompt)\\b(?=\\s+[a-zA-Z_][a-zA-Z0-9_]*\\s*\\()"
    },
    "keywords_ai": {
      "name": "keyword.other.ai.nekova",
      "match": "\\b(think|stream|imagine|speak|listen|model|autonomous|parallel|collect|generate|process|pipeline|run|retry|observe|fallback|each|fetch|watch|every|shape)\\b"
    },
    "keywords_control": {
      "name": "keyword.control.nekova",
      "match": "\\b(if|else|elif|repeat|while|for|in|return|break|continue|try|catch|finally|raise|pass|match|when|yield|with|global|assert)\\b"
    },
    "keywords_declaration": {
      "name": "keyword.declaration.nekova",
      "match": "\\b(task|func|use|import|from|let|async|await|class|object|error|schema|save)\\b"
    },
    "keywords_class": {
      "name": "keyword.other.class.nekova",
      "match": "\\b(init|new|extends|super)\\b"
    },
    "keywords_memory": {
      "name": "keyword.other.memory.nekova",
      "match": "\\b(remember|recall|forget|memory)\\b"
    },
    "keywords_web": {
      "name": "keyword.other.web.nekova",
      "match": "\\b(route|serve|GET|POST|PUT|DELETE|PATCH|request|response|port)\\b"
    },
    "keywords_db": {
      "name": "keyword.other.db.nekova",
      "match": "\\b(connect|query|insert|create|update|delete)\\b"
    },
    "keywords_sandbox": {
      "name": "keyword.other.sandbox.nekova",
      "match": "\\b(sandbox|strict|relaxed)\\b"
    },
    "keywords_logic": {
      "name": "keyword.operator.logical.nekova",
      "match": "\\b(and|or|not|is|as)\\b"
    },
    "keywords_test": {
      "name": "keyword.other.test.nekova",
      "match": "\\b(test|expect|mock)\\b"
    },
    "booleans": {
      "name": "constant.language.nekova",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nekova",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.scientific.nekova",
          "match": "\\b\\d[\\d_]*\\.?[\\d_]*[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.float.nekova",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.nekova",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.nekova",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.augmented-assignment.nekova",
          "match": "(\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.assignment.nekova",
          "match": "(?<![=!<>+\\-*/])=(?!=)"
        },
        {
          "name": "keyword.operator.power.nekova",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.floor-division.nekova",
          "match": "//"
        },
        {
          "name": "keyword.operator.arithmetic.nekova",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.pipeline.ai.nekova",
          "match": "->"
        },
        {
          "name": "keyword.operator.pipe.nekova",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.range.nekova",
          "match": "\\.\\."
        }
      ]
    },
    "task_definition": {
      "match": "\\b(task|func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.nekova"
        },
        "2": {
          "name": "entity.name.function.nekova"
        }
      }
    },
    "function_calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.nekova"
        }
      }
    },
    "stdlib_modules": {
      "match": "(?<=use )\\b(math|string|file|date|text|files|datetime|collections|json|env|uuid|crypto|vision|voice|random|csv)\\b",
      "captures": {
        "0": {
          "name": "entity.name.namespace.nekova"
        }
      }
    },
    "builtins": {
      "name": "support.function.builtin.nekova",
      "match": "\\b(show|ask|sleep|clear|type_of|len|length|range|int|str|float|bool|list|abs|min|max|sum|round|sorted|reversed|enumerate|zip|map|filter|any|all|input|pow|chr|ord|hex|bin|oct|print|to_text|to_number|to_list|random_number|random_choice|error_message)\\b"
    },
    "self_keyword": {
      "name": "variable.language.self.nekova",
      "match": "\\bself\\b"
    },
    "variables": {
      "name": "variable.other.nekova",
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
    }
  }
}