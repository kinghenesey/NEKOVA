{
    "name": "NEKOVA",
    "scopeName": "source.nekova",
    "fileTypes": ["nk"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#modules" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#operators" },
        { "include": "#functions" },
        { "include": "#variables" },
        { "include": "#interpolation" }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.hash.nekova",
            "match": "#.*$"
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.nekova",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "include": "#interpolation" },
                        {
                            "name": "constant.character.escape.nekova",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.nekova",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.nekova",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "interpolation": {
            "name": "meta.interpolation.nekova",
            "match": "\\{([a-zA-Z_][a-zA-Z0-9_]*)\\}",
            "captures": {
                "1": {
                    "name": "variable.other.nekova"
                }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.nekova",
                    "match": "\\b(if|else|repeat|while|for|in|return|try|catch)\\b"
                },
                {
                    "name": "keyword.declaration.nekova",
                    "match": "\\b(task|use|import|pipeline|memory|sandbox)\\b"
                },
                {
                    "name": "keyword.operator.logical.nekova",
                    "match": "\\b(and|or|not)\\b"
                },
                {
                    "name": "keyword.ai.nekova",
                    "match": "\\b(think|model|autonomous|parallel|collect|generate|save|with|run|strict|relaxed)\\b"
                },
                {
                    "name": "support.function.nekova",
                    "match": "\\b(show)\\b"
                }
            ]
        },
        "builtins": {
            "name": "support.function.builtin.nekova",
            "match": "\\b(to_text|to_number|length|ask|clear|sleep|type_of|random_num|sqrt|floor|ceil|abs|round|upper|lower|trim|replace|contains|split|join|today|now|year|month|day|ai_ask|ai_summarize|ai_generate|ai_classify|ai_stream|ai_remember|ai_forget|ai_image|db_connect|db_create|db_insert|db_find|db_update|db_delete|db_count|db_close|web_app|web_route|web_start|ui_app|ui_page|ui_title|ui_text|ui_button|ui_save|agent_create|agent_run|agent_tool|workflow_create|workflow_run|vision_scan|vision_compare|voice_speak|voice_listen|voice_save)\\b"
        },
        "modules": {
            "name": "entity.name.namespace.nekova",
            "match": "(?<=use )\\b(math|text|files|datetime|collections|ai|agents|ui|web|database|vision|voice)\\b"
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.nekova",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.nekova",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "booleans": {
            "name": "constant.language.nekova",
            "match": "\\b(true|false|null)\\b"
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.nekova",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.assignment.nekova",
                    "match": "(?<![=!<>])=(?!=)"
                },
                {
                    "name": "keyword.operator.arithmetic.nekova",
                    "match": "(\\+|-|\\*\\*|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.pipeline.nekova",
                    "match": "->"
                }
            ]
        },
        "functions": {
            "name": "entity.name.function.nekova",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        },
        "variables": {
            "name": "variable.other.nekova",
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b"
        }
    }
}