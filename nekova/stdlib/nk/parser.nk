# ═══════════════════════════════════════════════════════════════
# NEKOVA Standard Library — parser.nk
# Phase 27. ALL layers complete: Layer 1 (core grammar), Layer 2
# (all AI-native constructs across every sub-slice: think/shape/
# sandbox/test, memory-store, agent-conversation, orchestration,
# stragglers), and now Layer 3 (classes/self/new, async/await,
# stream think, match, retry/observe/fallback). Self-hosted parser.nk
# now covers the full language grammar end to end.
#
# Self-hosted port of nekova/parser/parser.py, written directly
# against GRAMMAR.md and the live Python parser — same relationship
# lexer.nk (Phase 20) has to nekova/lexer/lexer.py. Consumes the
# token dicts produced by lexer.nk's tokenize(source).a
#
# AST shape: every node is a dict with a "type" field matching the
# Python Node class name 1:1 (e.g. "IntegerLiteral", "BinaryOp",
# "IfStatement"), plus a "line" field, plus whatever fields that
# node needs. This mirrors the token-dict convention lexer.nk uses,
# so NEKOVA never has to lean on classes it doesn't have yet while
# bootstrapping its own parser.
#
# Layer 1 scope (shipped):
#   - Full expression precedence chain (pipe -> ternary -> or -> and
#     -> comparison -> addition -> multiplication -> unary -> primary),
#     including literals, identifiers, calls, index/slice, property
#     and method access, optional chaining, list/dict/set/tuple
#     literals with spread, f-strings, and grouped/tuple parens.
#   - let / const / global / unpack (incl. list/tuple/dict destructure)
#   - if/elif/else, while, repeat, for, try/catch/finally
#   - task definitions (typed + untyped params, return type, varargs,
#     docstrings)
#   - return / break / continue / pass / show
#   - identifier statements: assignment, augmented assignment,
#     index assignment, call statements, dot-chain statements
#
# Layer 2a scope (agreed before writing this slice — core AI
# primitives + safety, the foundation everything else in "AI-native
# constructs" validates against or builds on):
#   - think (statement + expression form), with using/with budget/
#     when error clauses; think ... as json/list/bool/text/number/
#     schema {...}
#   - shape_def, error_def (field-list declarations: NAME type [=default])
#   - enum_def (single-line comma-separated members)
#   - prompt_def (templated task; bare-string body auto-parsed as an
#     f-string template, matching _parse_prompt_body)
#   - sandbox_stmt (strict/relaxed mode, optional capability allow-list)
#   - test / expect / mock (probabilistic test blocks, repeat N times
#     / expect at least K passes; mock think as ... for stubbing
#     inside tests)
#
# Still DEFERRED to a later Layer 2 slice (memory & agents: remember/
# recall/forget, converse/speak/listen, autonomous/memory/pipeline/
# model/run/every/watch/imagine/retry/observe/route/serve, plus
# import/use/assert/raise/yield/decorator/match) and Layer 3
# (classes, async, self/new). Encountering one of those constructs
# raises a clear "not yet supported" ParseError rather than
# mis-parsing or crashing — see parse_statement's final dispatch
# branches.
#
# Entry point:  parse(source) -> list of statement-node dicts
#               (tokenizes internally via lexer.nk's tokenize())
# ═══════════════════════════════════════════════════════════════

use lexer

# ── Deferred-construct keyword sets ─────────────────────────────
# Anything landing here gets a clear "deferred to a later layer"
# error instead of silently mis-parsing. Kept as a set-shaped dict
# (value unused) so membership checks read the same way as a real
# set would.

# Both empty now — Layer 3 (this slice) covers everything that was
# still deferred: match, await/async, retry/observe/fallback, and
# classes/self/new. Kept as empty dicts (rather than deleted, along
# with their .get() call sites) so a future construct can be added
# to either set again with a one-line change if needed.

DEFERRED_AI_NATIVE_STATEMENT_TYPES = {}

DEFERRED_CLASS_TYPES = {}

# ── Parser state ─────────────────────────────────────────────────

task new_parser_state(tokens):
    return {
        "tokens": tokens,
        "pos": 0
    }

task current(state):
    return state["tokens"][state["pos"]]

task peek_type(state, offset):
    idx = state["pos"] + offset
    if idx < len(state["tokens"]):
        return state["tokens"][idx]["type"]
    return "EOF"

task at_end(state):
    return current(state)["type"] == "EOF"

task advance(state):
    tok = state["tokens"][state["pos"]]
    if state["pos"] < len(state["tokens"]) - 1:
        state["pos"] = state["pos"] + 1
    return tok

task consume(state, expected):
    tok = current(state)
    if tok["type"] != expected:
        raise ("Expected '" + expected + "' but got '" + tok["type"] +
               "' ('" + str(tok["value"]) + "') at line " + str(tok["line"]) + ".")
    return advance(state)

task skip_newlines(state):
    while not at_end(state) and current(state)["type"] == "NEWLINE":
        advance(state)

task expect_newline_or_eof(state):
    if current(state)["type"] == "NEWLINE":
        advance(state)
    # anything else: leave it — the next parse attempt surfaces the error

task stamp(node, line):
    node["line"] = line
    return node

# ── Entry point ───────────────────────────────────────────────────

task parse(source):
    tokens = tokenize(source)
    state = new_parser_state(tokens)
    statements = []

    skip_newlines(state)
    while not at_end(state):
        stmt = parse_statement(state)
        if stmt != null:
            statements.append(stmt)
        skip_newlines(state)

    return statements

# ── Statement dispatch ────────────────────────────────────────────

task parse_statement(state):
    token = current(state)
    t = token["type"]

    if t == "SHOW":
        return parse_show(state)
    if t == "STRING":
        # Could be a standalone pipeline: "prompt" -> agent1 -> agent2
        first = parse_primary(state)
        if current(state)["type"] == "ARROW":
            return parse_pipeline(state, first)
        raise ("Unexpected string — did you mean to use 'show' or '->'? Line " +
               str(token["line"]) + ".")
    if t == "ARROW":
        return parse_pipeline(state, parse_primary(state))
    if t == "MODEL":
        return parse_model(state)
    if t == "PIPELINE_DEF":
        return parse_pipeline_def(state)
    if t == "RUN":
        return parse_run_pipeline(state)
    if t == "AUTONOMOUS":
        return parse_autonomous(state)
    if t == "EVERY":
        return parse_every(state)
    if t == "WATCH":
        return parse_watch(state)
    if t == "IMAGINE":
        return parse_imagine(state)
    if t == "YIELD":
        return parse_yield(state)
    if t == "AT":
        return parse_decorator(state)
    if t == "USE":
        return parse_use(state)
    if t == "IMPORT":
        return parse_import(state)
    if t == "FETCH":
        return parse_fetch_expr(state)
    if t == "ROUTE":
        return parse_route(state)
    if t == "SERVE":
        return parse_serve(state)
    if t == "MATCH":
        return parse_match(state)
    if t == "ASYNC":
        return parse_async_function(state)
    if t == "AWAIT":
        return parse_await_expr(state)
    if t == "STREAM":
        return parse_stream_think(state)
    if t == "OBJECT":
        return parse_class_definition(state)
    if t == "CLASS":
        return parse_class_definition(state)
    if t == "NEW":
        node = parse_new_instance(state)
        expect_newline_or_eof(state)
        return node
    if t == "SELF":
        return parse_self_expr(state)
    if t == "RETRY":
        return parse_retry(state)
    if t == "OBSERVE":
        return parse_observe(state)
    if t == "LET":
        return parse_let(state)
    if t == "CONST":
        return parse_const(state)
    if t == "GLOBAL":
        return parse_global(state)
    if t == "IF":
        return parse_if(state)
    if t == "WHILE":
        return parse_while(state)
    if t == "TRY":
        return parse_try(state)
    if t == "FOR":
        return parse_for(state)
    if t == "TASK":
        return parse_task(state)
    if t == "THINK":
        return parse_think(state)
    if t == "SANDBOX":
        return parse_sandbox(state)
    if t == "SHAPE":
        return parse_shape(state)
    if t == "ERROR_TYPE":
        return parse_error_def(state)
    if t == "ENUM":
        return parse_enum(state)
    if t == "TEST":
        return parse_test(state)
    if t == "EXPECT":
        return parse_expect(state)
    if t == "MOCK":
        return parse_mock(state)
    if t == "REMEMBER":
        return parse_remember(state)
    if t == "RECALL":
        return parse_recall(state)
    if t == "FORGET":
        return parse_forget(state)
    if t == "MEMORY":
        return parse_memory(state)
    if t == "CONVERSE":
        return parse_converse(state)
    if t == "SPEAK":
        return parse_speak(state)
    if t == "LISTEN":
        return parse_listen_stmt(state)
    if t == "RETURN":
        return parse_return(state)
    if t == "BREAK":
        line = token["line"]
        advance(state)
        expect_newline_or_eof(state)
        return stamp({"type": "BreakStatement"}, line)
    if t == "CONTINUE":
        line = token["line"]
        advance(state)
        expect_newline_or_eof(state)
        return stamp({"type": "ContinueStatement"}, line)

    if t == "REPEAT":
        # 'repeat(' with no space is a call to a variable/function
        # named 'repeat', not the loop — same disambiguation the
        # Python parser uses.
        if peek_type(state, 1) == "LPAREN":
            advance(state)
            expr = {"type": "Identifier", "name": "repeat"}
            call = finish_call(state, "repeat")
            expect_newline_or_eof(state)
            return call
        return parse_repeat(state)

    if t == "IDENTIFIER":
        if token["value"] == "pass":
            line = token["line"]
            advance(state)
            expect_newline_or_eof(state)
            return stamp({"type": "PassStatement"}, line)

        if token["value"] == "assert":
            return parse_assert(state)

        if token["value"] == "raise":
            return parse_raise(state)

        # 'prompt' is a soft keyword — only a definition when
        # immediately followed by IDENTIFIER '(', so existing code
        # using 'prompt' as an ordinary variable name keeps working.
        if token["value"] == "prompt" and looks_like_prompt_def(state):
            return parse_prompt(state)

        # Tuple unpacking: a, b, c = expr
        if peek_type(state, 1) == "COMMA":
            return parse_unpack(state)

        return parse_identifier_statement(state)

    if t == "NEWLINE" or t == "EOF":
        return null

    if DEFERRED_AI_NATIVE_STATEMENT_TYPES.get(t, false):
        raise ("'" + t + "' is an AI-native construct — not yet " +
               "supported by the self-hosted parser (Layer 2 work). " +
               "Line " + str(token["line"]) + ".")

    if DEFERRED_CLASS_TYPES.get(t, false):
        raise ("'" + t + "' (classes/self) is not yet supported by " +
               "the self-hosted parser (Layer 3 work). Line " +
               str(token["line"]) + ".")

    raise ("Unexpected token '" + str(token["value"]) +
           "' — NEKOVA doesn't know what to do with this here. Line " +
           str(token["line"]) + ".")

# ── Declarations ──────────────────────────────────────────────────

task parse_let(state):
    line = current(state)["line"]
    consume(state, "LET")

    if current(state)["type"] == "LBRACKET":
        return parse_list_destructure(state, line, "LBRACKET", "RBRACKET")
    if current(state)["type"] == "LPAREN":
        return parse_list_destructure(state, line, "LPAREN", "RPAREN")
    if current(state)["type"] == "LBRACE":
        return parse_dict_destructure(state, line)

    name = consume(state, "IDENTIFIER")["value"]

    type_hint = null
    if current(state)["type"] == "COLON":
        advance(state)
        if current(state)["type"] == "IDENTIFIER":
            type_hint = advance(state)["value"]

    consume(state, "ASSIGN")

    # Captured think: let thought = think "prompt" ...
    if current(state)["type"] == "THINK":
        node = parse_think(state)
        node["variable"] = name
        return stamp(node, line)

    # Captured parallel: let results = autonomous parallel: ...
    if current(state)["type"] == "AUTONOMOUS":
        node = parse_autonomous(state)
        node["variable"] = name
        return stamp(node, line)

    # Captured pipeline run: let result = run pipeline name
    if current(state)["type"] == "RUN":
        node = parse_run_pipeline(state)
        node["variable"] = name
        return stamp(node, line)

    # Fetch expression: let res = fetch "url" method "GET"
    # (only captured here, not in bare identifier assignment — matches
    # the reference parser's actual coverage, not embellished beyond it)
    if current(state)["type"] == "FETCH":
        value = parse_fetch_expr(state)
        expect_newline_or_eof(state)
        return stamp({"type": "AssignStatement", "name": name, "value": value,
                      "type_hint": type_hint, "is_const": false,
                      "is_declaration": true}, line)

    if DEFERRED_AI_NATIVE_STATEMENT_TYPES.get(current(state)["type"], false):
        raise ("Captured '" + current(state)["type"] + "' expressions " +
               "(let " + name + " = ...) are a later Layer 2 slice — " +
               "not yet supported. Line " + str(line) + ".")

    value = parse_expression(state)

    # Captured pipeline: let report = "prompt" -> agent1 -> agent2
    if current(state)["type"] == "ARROW":
        node = parse_pipeline(state, value)
        node["variable"] = name
        return stamp(node, line)

    expect_newline_or_eof(state)
    return stamp({
        "type": "AssignStatement", "name": name, "value": value,
        "type_hint": type_hint, "is_const": false, "is_declaration": true
    }, line)

task parse_list_destructure(state, line, open_tok, close_tok):
    consume(state, open_tok)
    targets = []
    rest = null
    if current(state)["type"] != close_tok:
        while true:
            if current(state)["type"] == "ELLIPSIS":
                advance(state)
                rest = consume(state, "IDENTIFIER")["value"]
                break
            targets.append(consume(state, "IDENTIFIER")["value"])
            if current(state)["type"] == "COMMA":
                advance(state)
                continue
            break
    consume(state, close_tok)
    consume(state, "ASSIGN")
    value = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({
        "type": "ListDestructureStatement", "targets": targets,
        "rest": rest, "value": value
    }, line)

task parse_dict_destructure(state, line):
    consume(state, "LBRACE")
    keys = []
    if current(state)["type"] != "RBRACE":
        keys.append(consume(state, "IDENTIFIER")["value"])
        while current(state)["type"] == "COMMA":
            advance(state)
            keys.append(consume(state, "IDENTIFIER")["value"])
    consume(state, "RBRACE")
    consume(state, "ASSIGN")
    value = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "DictDestructureStatement", "keys": keys, "value": value}, line)

task parse_const(state):
    line = current(state)["line"]
    consume(state, "CONST")
    name = consume(state, "IDENTIFIER")["value"]

    type_hint = null
    if current(state)["type"] == "COLON":
        advance(state)
        if current(state)["type"] == "IDENTIFIER":
            type_hint = advance(state)["value"]

    consume(state, "ASSIGN")
    value = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({
        "type": "AssignStatement", "name": name, "value": value,
        "type_hint": type_hint, "is_const": true, "is_declaration": true
    }, line)

task parse_global(state):
    line = current(state)["line"]
    consume(state, "GLOBAL")
    names = [consume(state, "IDENTIFIER")["value"]]
    while current(state)["type"] == "COMMA":
        advance(state)
        names.append(consume(state, "IDENTIFIER")["value"])
    expect_newline_or_eof(state)
    return stamp({"type": "GlobalStatement", "names": names}, line)

task parse_unpack(state):
    line = current(state)["line"]
    names = [consume(state, "IDENTIFIER")["value"]]
    while current(state)["type"] == "COMMA":
        advance(state)
        names.append(consume(state, "IDENTIFIER")["value"])
    consume(state, "ASSIGN")
    value = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "UnpackStatement", "names": names, "value": value}, line)

# ── Control flow ──────────────────────────────────────────────────

task parse_if(state):
    line = current(state)["line"]
    consume(state, "IF")
    condition = parse_expression(state)
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)

    then_body = parse_block(state)
    skip_newlines(state)

    # Collect elif clauses first, then build the nested else-chain
    # from the end backwards. NEKOVA assignment deep-copies dicts/
    # lists (documented in interpreter.py — "prevent aliasing bugs"),
    # so a "keep a tail pointer and mutate it after storing it
    # elsewhere" approach silently doesn't propagate: once a dict is
    # embedded inside an already-assigned list/dict, further
    # mutation through a separate variable reference to the same
    # object no longer reaches the copy that got stored. Building
    # from the innermost clause outward — like the decorator
    # stacking below — never mutates anything after the fact, so it
    # works under copy semantics.
    elif_clauses = []
    while not at_end(state) and current(state)["type"] == "ELIF":
        advance(state)
        elif_condition = parse_expression(state)
        consume(state, "COLON")
        expect_newline_or_eof(state)
        skip_newlines(state)
        elif_body = parse_block(state)
        skip_newlines(state)
        elif_clauses.append([elif_condition, elif_body])

    final_else = []
    if not at_end(state) and current(state)["type"] == "ELSE":
        advance(state)
        consume(state, "COLON")
        expect_newline_or_eof(state)
        skip_newlines(state)
        final_else = parse_block(state)

    else_body = final_else
    i = len(elif_clauses) - 1
    while i >= 0:
        clause = elif_clauses[i]
        else_body = [{"type": "IfStatement", "condition": clause[0],
                      "then_body": clause[1], "else_body": else_body}]
        i = i - 1

    return stamp({"type": "IfStatement", "condition": condition,
                  "then_body": then_body, "else_body": else_body}, line)

task parse_repeat(state):
    line = current(state)["line"]
    consume(state, "REPEAT")
    count = parse_expression(state)
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "RepeatStatement", "count": count, "body": body}, line)

task parse_while(state):
    line = current(state)["line"]
    consume(state, "WHILE")
    condition = parse_expression(state)
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "WhileStatement", "condition": condition, "body": body}, line)

task parse_try(state):
    line = current(state)["line"]
    consume(state, "TRY")
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    try_body = parse_block(state)
    skip_newlines(state)

    catch_body = []
    error_var = null
    if current(state)["type"] == "CATCH":
        advance(state)
        if current(state)["type"] == "IDENTIFIER":
            error_var = advance(state)["value"]
        consume(state, "COLON")
        expect_newline_or_eof(state)
        skip_newlines(state)
        catch_body = parse_block(state)
        skip_newlines(state)

    finally_body = []
    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "finally":
        advance(state)
        consume(state, "COLON")
        expect_newline_or_eof(state)
        skip_newlines(state)
        finally_body = parse_block(state)

    return stamp({
        "type": "TryStatement", "try_body": try_body, "catch_body": catch_body,
        "error_var": error_var, "finally_body": finally_body
    }, line)

task parse_for(state):
    line = current(state)["line"]
    consume(state, "FOR")

    variables = [consume(state, "IDENTIFIER")["value"]]
    while current(state)["type"] == "COMMA":
        advance(state)
        variables.append(consume(state, "IDENTIFIER")["value"])

    variable = variables[0]
    if len(variables) > 1:
        variable = variables

    consume(state, "IN")
    iterable = parse_expression(state)
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)

    return stamp({"type": "ForStatement", "variable": variable,
                  "iterable": iterable, "body": body}, line)

task parse_return(state):
    line = current(state)["line"]
    consume(state, "RETURN")
    if current(state)["type"] == "NEWLINE" or current(state)["type"] == "EOF":
        return stamp({"type": "ReturnStatement", "value": null}, line)
    value = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "ReturnStatement", "value": value}, line)

task parse_show(state):
    line = current(state)["line"]
    consume(state, "SHOW")
    expr = parse_expression(state)
    extras = []
    while current(state)["type"] == "COMMA":
        advance(state)
        extras.append(parse_expression(state))
    expect_newline_or_eof(state)
    return stamp({"type": "ShowStatement", "expression": expr, "extra_expressions": extras}, line)

# ── Task definitions ──────────────────────────────────────────────

task parse_task_param_list(state):
    consume(state, "LPAREN")
    params = []
    while current(state)["type"] != "RPAREN":
        is_vararg = false
        if current(state)["type"] == "MULTIPLY":
            advance(state)
            is_vararg = true
        pname = consume(state, "IDENTIFIER")["value"]

        type_hint = null
        if current(state)["type"] == "COLON":
            advance(state)
            type_hint = consume(state, "IDENTIFIER")["value"]

        default = null
        if current(state)["type"] == "ASSIGN":
            advance(state)
            default = parse_expression(state)

        params.append([pname, type_hint, default, is_vararg])
        if current(state)["type"] == "COMMA":
            advance(state)
    consume(state, "RPAREN")
    return params

task any_param_has_type_hint(params):
    for p in params:
        if p[1] != null:
            return true
    return false

task parse_task(state):
    line = current(state)["line"]
    consume(state, "TASK")
    name = advance(state)["value"]  # allow keyword names, matching Python

    params = parse_task_param_list(state)

    return_type = null
    if current(state)["type"] == "ARROW":
        advance(state)
        return_type = consume(state, "IDENTIFIER")["value"]

    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    result = parse_block_with_docstring(state)
    docstring = result[0]
    body = result[1]

    if return_type != null or any_param_has_type_hint(params):
        return stamp({
            "type": "TypedTaskStatement", "name": name, "params": params,
            "body": body, "return_type": return_type, "docstring": docstring
        }, line)

    # Back-compat shape: strip type hints to (name, default, is_vararg)
    simple = []
    for p in params:
        simple.append([p[0], p[2], p[3]])
    return stamp({
        "type": "TaskStatement", "name": name, "params": simple,
        "body": body, "docstring": docstring
    }, line)

# ── Layer 2a: core AI primitives & safety ──────────────────────────

# 'using'/'budget'/'error' are soft keywords here — matched by
# identifier value where the grammar calls for them, so none of
# these words are taken away from use as ordinary variable names
# elsewhere in the language (same convention parse_try's 'finally'
# already relies on).

task parse_think_using_model(state):
    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "using":
        advance(state)
        return parse_expression(state)
    return null

task parse_think_with_budget(state):
    if current(state)["type"] != "WITH":
        return null
    advance(state)
    budget_tok = current(state)
    if budget_tok["value"] != "budget":
        raise ("Expected 'budget' after 'with' in a think clause, got '" +
               str(budget_tok["value"]) + "'. Example: think \"...\" with budget: 500")
    advance(state)
    consume(state, "COLON")
    return parse_expression(state)

task parse_think_on_error(state):
    if current(state)["type"] != "WHEN":
        return null
    advance(state)
    err_tok = current(state)
    if err_tok["value"] != "error":
        raise ("Expected 'error' after 'when' in a think clause, got '" +
               str(err_tok["value"]) + "'. Example: think \"...\" when error: \"fallback\"")
    advance(state)  # consume 'error' (lexes as ERROR_TYPE keyword)
    consume(state, "COLON")
    return parse_expression(state)

task parse_think_body(state, line):
    # Shared by parse_think (statement) and parse_think_expr — parses
    # everything after 'think', through the optional as/using/with/when
    # clauses, but does NOT consume the trailing newline; callers do
    # that themselves (statement form always does, expression form
    # leaves it to whatever is parsing the enclosing expression).
    prompt = parse_expression(state)

    if current(state)["type"] == "AS":
        advance(state)
        fmt_tok = current(state)

        if fmt_tok["type"] == "IDENTIFIER":
            fmt = fmt_tok["value"].lower()
            advance(state)
            if fmt == "schema":
                schema = parse_expression(state)
                model_expr = parse_think_using_model(state)
                budget = parse_think_with_budget(state)
                on_error = parse_think_on_error(state)
                return stamp({"type": "ThinkAsStatement", "prompt": prompt, "variable": null,
                              "as_format": "schema", "schema": schema, "model": model_expr,
                              "budget": budget, "on_error": on_error}, line)
            model_expr = parse_think_using_model(state)
            budget = parse_think_with_budget(state)
            on_error = parse_think_on_error(state)
            return stamp({"type": "ThinkAsStatement", "prompt": prompt, "variable": null,
                          "as_format": fmt, "schema": null, "model": model_expr,
                          "budget": budget, "on_error": on_error}, line)

        if fmt_tok["type"] == "LBRACE":
            schema = parse_expression(state)
            model_expr = parse_think_using_model(state)
            budget = parse_think_with_budget(state)
            on_error = parse_think_on_error(state)
            return stamp({"type": "ThinkAsStatement", "prompt": prompt, "variable": null,
                          "as_format": "schema", "schema": schema, "model": model_expr,
                          "budget": budget, "on_error": on_error}, line)

    model_expr = parse_think_using_model(state)
    budget = parse_think_with_budget(state)
    on_error = parse_think_on_error(state)
    return stamp({"type": "ThinkStatement", "prompt": prompt, "variable": null,
                  "model": model_expr, "budget": budget, "on_error": on_error}, line)

task parse_think(state):
    line = current(state)["line"]
    consume(state, "THINK")
    node = parse_think_body(state, line)
    expect_newline_or_eof(state)
    return node

task parse_think_expr(state):
    # think used inside a larger expression (return think ..., show
    # think ..., x + think ..., etc.) — same body, caller owns the
    # trailing newline.
    line = current(state)["line"]
    consume(state, "THINK")
    return parse_think_body(state, line)

# ── shape / error / enum declarations ──────────────────────────────

task parse_field_list_def(state, node_type, consume_type):
    line = current(state)["line"]
    consume(state, consume_type)
    name = consume(state, "IDENTIFIER")["value"]
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)

    fields = []
    consume(state, "INDENT")
    while current(state)["type"] != "DEDENT" and current(state)["type"] != "EOF":
        if current(state)["type"] == "NEWLINE":
            advance(state)
            continue
        fname = consume(state, "IDENTIFIER")["value"]
        ftype = consume(state, "IDENTIFIER")["value"]
        default = null
        if current(state)["type"] == "ASSIGN":
            advance(state)
            default = parse_expression(state)
        fields.append([fname, ftype, default])
        if current(state)["type"] == "NEWLINE":
            advance(state)
    if current(state)["type"] == "DEDENT":
        advance(state)

    return stamp({"type": node_type, "name": name, "fields": fields}, line)

task parse_shape(state):
    return parse_field_list_def(state, "ShapeDefinition", "SHAPE")

task parse_error_def(state):
    return parse_field_list_def(state, "ErrorDefinition", "ERROR_TYPE")

task parse_enum(state):
    line = current(state)["line"]
    consume(state, "ENUM")
    name = consume(state, "IDENTIFIER")["value"]
    consume(state, "COLON")

    members = [consume(state, "IDENTIFIER")["value"]]
    while current(state)["type"] == "COMMA":
        advance(state)
        members.append(consume(state, "IDENTIFIER")["value"])

    expect_newline_or_eof(state)
    return stamp({"type": "EnumDefinition", "name": name, "members": members}, line)

# ── prompt definitions ───────────────────────────────────────────────

task looks_like_prompt_def(state):
    # Disambiguates 'prompt name(...):' from 'prompt' used as an
    # ordinary variable (e.g. prompt = "x", show prompt). Only a
    # definition when immediately followed by IDENTIFIER '('.
    nxt = peek_type(state, 1)
    nxt2 = peek_type(state, 2)
    return nxt == "IDENTIFIER" and nxt2 == "LPAREN"

task parse_prompt(state):
    line = current(state)["line"]
    advance(state)  # consume the 'prompt' identifier token
    name = advance(state)["value"]
    params = parse_task_param_list(state)
    consume(state, "COLON")
    expect_newline_or_eof(state)
    body = parse_prompt_body(state)
    return stamp({"type": "PromptStatement", "name": name, "params": params,
                  "body": body}, line)

task parse_prompt_body(state):
    # Like parse_block, but a bare STRING/F_STRING statement is
    # allowed and parsed as an interpolation template via
    # parse_fstring, so {var} placeholders resolve against the
    # prompt's own parameters even without an 'f' prefix.
    if current(state)["type"] != "NEWLINE" and current(state)["type"] != "INDENT":
        if current(state)["type"] == "STRING":
            tok = advance(state)
            return [parse_fstring(tok["value"])]
        stmt = parse_statement(state)
        if stmt != null:
            return [stmt]
        return []

    skip_newlines(state)

    if current(state)["type"] != "INDENT":
        raise ("Expected an indented block here. Did you forget to indent? Line " +
               str(current(state)["line"]) + ".")

    consume(state, "INDENT")
    skip_newlines(state)

    statements = []
    while not at_end(state) and current(state)["type"] != "DEDENT":
        if current(state)["type"] == "STRING":
            tok = advance(state)
            expect_newline_or_eof(state)
            statements.append(parse_fstring(tok["value"]))
        else:
            stmt = parse_statement(state)
            if stmt != null:
                statements.append(stmt)
        skip_newlines(state)

    if current(state)["type"] == "DEDENT":
        consume(state, "DEDENT")

    return statements

# ── sandbox ───────────────────────────────────────────────────────

task parse_sandbox(state):
    line = current(state)["line"]
    consume(state, "SANDBOX")

    mode_token = current(state)
    mode = null
    if mode_token["type"] == "STRICT":
        mode = "strict"
        advance(state)
    elif mode_token["type"] == "RELAXED":
        mode = "relaxed"
        advance(state)
    else:
        raise ("Expected 'strict' or 'relaxed' after 'sandbox', got '" +
               str(mode_token["value"]) + "'. Line " + str(mode_token["line"]) + ".")

    allow = null
    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "allow":
        advance(state)
        consume(state, "COLON")
        consume(state, "LBRACKET")
        allow = []
        while current(state)["type"] != "RBRACKET":
            allow.append(consume(state, "IDENTIFIER")["value"])
            if current(state)["type"] == "COMMA":
                advance(state)
        consume(state, "RBRACKET")

    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "SandboxStatement", "mode": mode, "body": body,
                  "allow": allow}, line)

# ── test / expect / mock ─────────────────────────────────────────────

task parse_test(state):
    line = current(state)["line"]
    consume(state, "TEST")
    label = consume(state, "STRING")["value"]

    repeat_count = null
    min_passes = null

    if current(state)["type"] == "REPEAT":
        advance(state)
        repeat_count = parse_expression(state)
        if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "times":
            advance(state)

        if current(state)["type"] == "COMMA":
            advance(state)
            if current(state)["type"] != "EXPECT":
                raise ("Expected 'expect at least <n> passes' after 'repeat <n> " +
                       "times,' in a test block. Example: test \"label\" repeat 10 " +
                       "times, expect at least 8 passes: Line " + str(line) + ".")
            advance(state)  # 'expect'
            if not (current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "at"):
                raise ("Expected 'at least <n> passes'. Example: expect at least " +
                       "8 passes. Line " + str(current(state)["line"]) + ".")
            advance(state)  # 'at'
            if not (current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "least"):
                raise ("Expected 'least <n> passes'. Example: expect at least " +
                       "8 passes. Line " + str(current(state)["line"]) + ".")
            advance(state)  # 'least'
            min_passes = parse_expression(state)
            if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "passes":
                advance(state)

    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "TestBlock", "label": label, "body": body,
                  "repeat_count": repeat_count, "min_passes": min_passes}, line)

task parse_expect(state):
    line = current(state)["line"]
    consume(state, "EXPECT")
    expr = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "ExpectStatement", "expression": expr}, line)

task parse_mock(state):
    line = current(state)["line"]
    consume(state, "MOCK")
    target = advance(state)["value"]  # e.g. "think" — allow keyword names
    consume(state, "AS")
    value = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "MockStatement", "target": target, "value": value}, line)

# ── memory store: remember / recall / forget / memory ─────────────

task parse_remember(state):
    line = current(state)["line"]
    advance(state)  # consume 'remember'
    key_expr = parse_expression(state)
    consume(state, "ASSIGN")
    value_expr = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "RememberStatement", "key_expr": key_expr,
                  "value_expr": value_expr}, line)

task parse_recall(state):
    # Statement form: recall "key" [or <default>]
    #
    # Uses addition-level parsing for the key (not the full
    # expression chain) so a following 'or' isn't swallowed into a
    # BinaryOp before we get to check for it — same reasoning
    # parse_recall_expr uses below. The Python reference parser gets
    # this wrong in a different way: its statement form checks for
    # the optional clause via
    # `token.type == IDENTIFIER and value == "or"` — but 'or' always
    # lexes as the reserved OR token (see token_types.py), never
    # IDENTIFIER, so that check can never match there either. Flagging
    # rather than silently mirroring — implemented correctly here.
    line = current(state)["line"]
    advance(state)  # consume 'recall'
    key_expr = parse_addition(state)
    default = null
    if current(state)["type"] == "OR":
        advance(state)
        default = parse_addition(state)
    expect_newline_or_eof(state)
    return stamp({"type": "RecallStatement", "key_expr": key_expr,
                  "variable": null, "default": default}, line)

task parse_recall_expr(state):
    # Expression form: let x = recall "key" [or <default>]
    # Uses addition-level parsing for the key so a following OR isn't
    # swallowed by the full expression parser — same reasoning the
    # Python reference gives for this one.
    line = current(state)["line"]
    advance(state)  # consume 'recall'
    key_expr = parse_addition(state)
    default = null
    if current(state)["type"] == "OR":
        advance(state)
        default = parse_addition(state)
    return stamp({"type": "RecallStatement", "key_expr": key_expr,
                  "variable": null, "default": default}, line)

task parse_forget(state):
    line = current(state)["line"]
    advance(state)  # consume 'forget'
    cur = current(state)
    if cur["type"] == "IDENTIFIER" and cur["value"] == "all":
        advance(state)
        expect_newline_or_eof(state)
        return stamp({"type": "ForgetStatement", "forget_all": true,
                      "key_expr": null}, line)
    key_expr = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "ForgetStatement", "forget_all": false,
                  "key_expr": key_expr}, line)

task parse_memory(state):
    line = current(state)["line"]
    consume(state, "MEMORY")
    name = consume(state, "IDENTIFIER")["value"]
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "MemoryStatement", "name": name, "body": body}, line)

# ── agent conversation: speak / listen / converse ──────────────────

task parse_speak(state):
    line = current(state)["line"]
    consume(state, "SPEAK")
    expr = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "SpeakStatement", "expression": expr}, line)

task parse_listen_stmt(state):
    line = current(state)["line"]
    consume(state, "LISTEN")
    prompt = null
    if current(state)["type"] == "STRING":
        prompt = {"type": "StringLiteral", "value": advance(state)["value"]}
    expect_newline_or_eof(state)
    return stamp({"type": "ListenExpression", "prompt": prompt}, line)

task parse_converse(state):
    line = current(state)["line"]
    consume(state, "CONVERSE")
    consume(state, "COLON")
    body = parse_block(state)
    return stamp({"type": "ConverseStatement", "body": body}, line)

# ── orchestration: model / pipeline / autonomous / every / watch ────

task parse_model(state):
    line = current(state)["line"]
    consume(state, "MODEL")
    provider = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "ModelStatement", "provider": provider}, line)

task parse_pipeline(state, first_step):
    # step -> step -> step ; 'first_step' is already parsed — continue
    # from the first '->'.
    line = current(state)["line"]
    steps = [first_step]
    while current(state)["type"] == "ARROW":
        advance(state)
        step = parse_primary(state)
        steps.append(step)
    expect_newline_or_eof(state)
    return stamp({"type": "PipelineStatement", "steps": steps, "variable": null}, line)

task parse_autonomous(state):
    line = current(state)["line"]
    consume(state, "AUTONOMOUS")
    consume(state, "PARALLEL")
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "ParallelStatement", "body": body, "variable": null}, line)

task parse_pipeline_def(state):
    line = current(state)["line"]
    consume(state, "PIPELINE_DEF")
    name = consume(state, "IDENTIFIER")["value"]
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)

    steps = []
    consume(state, "INDENT")
    skip_newlines(state)

    while not at_end(state) and current(state)["type"] != "DEDENT":
        token = current(state)

        if token["type"] == "COLLECT":
            advance(state)
            expr = parse_expression(state)
            steps.append({"type": "collect", "expr": expr})
        elif token["type"] == "IDENTIFIER" and token["value"] == "process":
            advance(state)  # consume 'process'
            if current(state)["type"] == "WITH":
                advance(state)
            provider = "ai"
            if current(state)["type"] == "IDENTIFIER":
                provider = advance(state)["value"]
            steps.append({"type": "process", "provider": provider})
        elif token["type"] == "GENERATE":
            advance(state)
            format_name = "report"
            if current(state)["type"] == "IDENTIFIER":
                format_name = advance(state)["value"]
            steps.append({"type": "generate", "format": format_name})
        elif token["type"] == "SAVE":
            advance(state)
            if current(state)["type"] == "IDENTIFIER":
                advance(state)  # consume 'to'
            target = "database"
            if current(state)["type"] == "IDENTIFIER":
                target = advance(state)["value"]
            steps.append({"type": "save", "target": target})
        else:
            advance(state)  # skip unknown tokens, matching reference

        skip_newlines(state)

    if current(state)["type"] == "DEDENT":
        consume(state, "DEDENT")

    return stamp({"type": "PipelineDefStatement", "name": name, "steps": steps}, line)

task parse_run_pipeline(state):
    line = current(state)["line"]
    consume(state, "RUN")
    consume(state, "PIPELINE_DEF")
    name = consume(state, "IDENTIFIER")["value"]
    expect_newline_or_eof(state)
    return stamp({"type": "RunPipelineStatement", "name": name, "variable": null}, line)

task parse_every(state):
    line = current(state)["line"]
    consume(state, "EVERY")

    interval_val = parse_expression(state)

    # interval unit — must be an identifier ending in s/m/h, e.g.
    # "5s" lexes as INTEGER(5) IDENTIFIER(s), or the user writes it
    # with a space: "every 5 s:"
    unit = "s"
    cur = current(state)
    time_units = {"s": true, "m": true, "h": true, "ms": true}
    if cur["type"] == "IDENTIFIER" and time_units.get(cur["value"], false):
        unit = cur["value"]
        advance(state)

    # optional "X times" (bare "forever" needs nothing extra — no
    # max_runs means run forever, matching the reference)
    max_runs = null
    if current(state)["type"] == "INTEGER":
        max_runs = advance(state)["value"]
        if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "times":
            advance(state)

    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "EveryStatement", "interval_value": interval_val,
                  "interval_unit": unit, "body": body, "max_runs": max_runs}, line)

task parse_watch(state):
    line = current(state)["line"]
    consume(state, "WATCH")
    target = parse_expression(state)
    is_file = target["type"] == "StringLiteral"
    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)
    return stamp({"type": "WatchStatement", "target": target, "body": body,
                  "is_file": is_file}, line)

# ── stragglers: imagine / yield / decorators / assert / raise /
#    use / import / fetch / route / serve ──────────────────────────

task parse_imagine(state):
    line = current(state)["line"]
    consume(state, "IMAGINE")
    prompt = parse_expression(state)
    fmt = "url"
    if current(state)["type"] == "AS":
        advance(state)
        fmt = consume(state, "IDENTIFIER")["value"]
    expect_newline_or_eof(state)
    return stamp({"type": "ImagineStatement", "prompt": prompt, "result_var": null,
                  "result_format": fmt}, line)

task parse_imagine_expr(state):
    line = current(state)["line"]
    consume(state, "IMAGINE")
    prompt = parse_expression(state)
    fmt = "url"
    if current(state)["type"] == "AS":
        advance(state)
        fmt = consume(state, "IDENTIFIER")["value"]
    return stamp({"type": "ImagineStatement", "prompt": prompt, "result_var": null,
                  "result_format": fmt}, line)

task parse_yield(state):
    line = current(state)["line"]
    consume(state, "YIELD")
    expr = null
    stop_types = {"NEWLINE": true, "EOF": true, "DEDENT": true}
    if not stop_types.get(current(state)["type"], false):
        expr = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "YieldStatement", "expression": expr}, line)

task parse_decorator_expr(state):
    # A single @name or @name(args) decorator, without the trailing
    # newline handling — shared by the first and each stacked decorator.
    name = advance(state)["value"]  # allow keyword names
    node = {"type": "Identifier", "name": name}
    if current(state)["type"] == "LPAREN":
        advance(state)
        let args = []
        while current(state)["type"] != "RPAREN":
            args.append(parse_expression(state))
            if current(state)["type"] == "COMMA":
                advance(state)
        consume(state, "RPAREN")
        # NOTE: the reference parser passes an Identifier node (not a
        # plain string) as CallExpression.name here specifically —
        # inconsistent with every other CallExpression in the
        # grammar, which use a plain string, but it's the actual
        # ground-truth behaviour, so mirrored rather than "corrected".
        node = {"type": "CallExpression", "name": {"type": "Identifier", "name": name},
                "args": args, "kwargs": {}}
    return node

task parse_decorator(state):
    line = current(state)["line"]
    consume(state, "AT")
    decorators = [parse_decorator_expr(state)]
    expect_newline_or_eof(state)
    skip_newlines(state)

    while current(state)["type"] == "AT":
        advance(state)
        decorators.append(parse_decorator_expr(state))
        expect_newline_or_eof(state)
        skip_newlines(state)

    if current(state)["type"] != "TASK":
        raise ("Expected 'task' after decorator, got '" +
               str(current(state)["value"]) + "'. Line " +
               str(current(state)["line"]) + ".")
    target = parse_task(state)

    # Apply right-to-left, matching the reference
    node = target
    i = len(decorators) - 1
    while i >= 0:
        node = stamp({"type": "DecoratorStatement", "decorator_expr": decorators[i],
                      "target": node}, line)
        i = i - 1
    return node

task parse_assert(state):
    line = current(state)["line"]
    advance(state)  # consume 'assert'
    condition = parse_expression(state)
    message = null
    if current(state)["type"] == "COMMA":
        advance(state)
        message = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "AssertStatement", "condition": condition, "message": message}, line)

task parse_raise(state):
    line = current(state)["line"]
    advance(state)  # consume 'raise'
    expr = parse_expression(state)
    expect_newline_or_eof(state)
    return stamp({"type": "RaiseStatement", "expression": expr}, line)

task parse_use(state):
    consume(state, "USE")
    module = consume(state, "IDENTIFIER")["value"]
    expect_newline_or_eof(state)
    return {"type": "UseStatement", "module": module}

task parse_import(state):
    consume(state, "IMPORT")

    if current(state)["type"] == "STRING":
        filepath = consume(state, "STRING")["value"]
        expect_newline_or_eof(state)
        return {"type": "ImportStatement", "filepath": filepath, "names": null}

    names = [consume(state, "IDENTIFIER")["value"]]
    while current(state)["type"] == "COMMA" or (current(state)["type"] == "IDENTIFIER" and current(state)["value"] != "from"):
        if current(state)["type"] == "COMMA":
            advance(state)
        if current(state)["type"] == "IDENTIFIER" and current(state)["value"] != "from":
            names.append(consume(state, "IDENTIFIER")["value"])

    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "from":
        advance(state)
    else:
        raise ("Expected 'from' after import names, got '" +
               str(current(state)["value"]) + "'.")

    filepath = consume(state, "STRING")["value"]
    expect_newline_or_eof(state)
    return {"type": "ImportStatement", "filepath": filepath, "names": names}

task parse_fetch_expr(state):
    # fetch <url_expr>
    # fetch <url_expr> method "POST" headers {...} body {...}
    # Modifiers are optional and order-independent. Note: this is
    # only reachable as a top-level statement or via 'let x = fetch
    # ...' (see parse_let) — not from general expression contexts —
    # matching the reference parser's actual coverage.
    consume(state, "FETCH")
    url = parse_expression(state)

    method = "GET"
    headers = {}
    body_expr = null

    while current(state)["type"] == "IDENTIFIER":
        kw = current(state)["value"].lower()
        if kw == "method":
            advance(state)
            method = consume(state, "STRING")["value"].upper()
        elif kw == "headers":
            advance(state)
            headers = parse_expression(state)
        elif kw == "body":
            advance(state)
            body_expr = parse_expression(state)
        else:
            break

    return {"type": "FetchNode", "url": url, "method": method,
            "headers": headers, "body_expr": body_expr}

task parse_route(state):
    advance(state)  # consume 'route'

    method_tok = current(state)
    if method_tok["type"] != "IDENTIFIER":
        raise ("Expected HTTP method after 'route' (GET, POST, PUT, DELETE). Line " +
               str(method_tok["line"]) + ".")
    method = method_tok["value"].upper()
    advance(state)

    path_tok = current(state)
    if path_tok["type"] != "STRING" and path_tok["type"] != "F_STRING":
        raise ("Expected path string after HTTP method. Line " +
               str(path_tok["line"]) + ".")
    path = path_tok["value"]
    advance(state)

    consume(state, "COLON")
    skip_newlines(state)
    body = parse_block(state)

    return {"type": "RouteStatement", "method": method, "path": path, "body": body}

task parse_serve(state):
    advance(state)  # consume 'serve'
    port_expr = null

    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "port":
        advance(state)
        consume(state, "COLON")
        port_expr = parse_expression(state)

    expect_newline_or_eof(state)
    return {"type": "ServeStatement", "port_expr": port_expr}

# ── Layer 3: classes / self / new ──────────────────────────────────

task parse_class_param_list(state):
    # Simpler than parse_task_param_list: (name: type, ...) pairs
    # only — no defaults, no varargs. Matches the reference's
    # dedicated class-param parser exactly.
    params = []
    while current(state)["type"] != "RPAREN" and current(state)["type"] != "EOF":
        if current(state)["type"] == "IDENTIFIER":
            pname = consume(state, "IDENTIFIER")["value"]
            phint = "any"
            if current(state)["type"] == "COLON":
                advance(state)
                if current(state)["type"] == "IDENTIFIER":
                    phint = consume(state, "IDENTIFIER")["value"]
            params.append([pname, phint])
            if current(state)["type"] == "COMMA":
                advance(state)
        else:
            break
    return params

task parse_class_definition(state):
    line = current(state)["line"]
    # Accept both 'object' and 'class' keywords
    if current(state)["type"] == "OBJECT" or current(state)["type"] == "CLASS":
        advance(state)
    else:
        consume(state, "OBJECT")
    name = consume(state, "IDENTIFIER")["value"]

    parent = null
    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "extends":
        advance(state)
        parent = consume(state, "IDENTIFIER")["value"]

    consume(state, "COLON")

    fields = []
    init_params = []
    init_body = []
    methods = []

    # Class body may have multiple INDENT/DEDENT pairs (the lexer
    # reindents on blank lines) — keep consuming them all.
    skip_newlines(state)

    while current(state)["type"] == "INDENT":
        advance(state)

        while current(state)["type"] != "DEDENT" and current(state)["type"] != "EOF":
            skip_newlines(state)
            if current(state)["type"] == "DEDENT" or current(state)["type"] == "EOF":
                break

            tok = current(state)

            if tok["type"] == "IDENTIFIER" and peek_type(state, 1) == "COLON":
                field_name = consume(state, "IDENTIFIER")["value"]
                consume(state, "COLON")
                type_hint = "any"
                if current(state)["type"] == "IDENTIFIER":
                    type_hint = consume(state, "IDENTIFIER")["value"]
                skip_newlines(state)
                fields.append([field_name, type_hint])
            elif tok["type"] == "INIT":
                consume(state, "INIT")
                consume(state, "LPAREN")
                init_params = parse_class_param_list(state)
                consume(state, "RPAREN")
                consume(state, "COLON")
                init_body = parse_block(state)
                skip_newlines(state)
            elif tok["type"] == "FUNC":
                consume(state, "FUNC")
                method_name = advance(state)["value"]  # allow keyword names
                consume(state, "LPAREN")
                params = parse_class_param_list(state)
                consume(state, "RPAREN")
                consume(state, "COLON")
                body = parse_block(state)
                skip_newlines(state)
                methods.append({"type": "MethodDefinition", "name": method_name,
                                "params": params, "body": body, "is_async": false})
            elif tok["type"] == "ASYNC":
                consume(state, "ASYNC")
                consume(state, "FUNC")
                method_name = advance(state)["value"]
                consume(state, "LPAREN")
                params = parse_class_param_list(state)
                consume(state, "RPAREN")
                consume(state, "COLON")
                body = parse_block(state)
                skip_newlines(state)
                methods.append({"type": "MethodDefinition", "name": method_name,
                                "params": params, "body": body, "is_async": true})
            else:
                advance(state)

        if current(state)["type"] == "DEDENT":
            advance(state)
        skip_newlines(state)

    return stamp({"type": "ClassDefinition", "name": name, "fields": fields,
                  "init_params": init_params, "init_body": init_body,
                  "methods": methods, "parent": parent}, line)

task parse_new_instance(state):
    line = current(state)["line"]
    consume(state, "NEW")
    class_name = consume(state, "IDENTIFIER")["value"]
    consume(state, "LPAREN")
    let args = []
    while current(state)["type"] != "RPAREN":
        args.append(parse_expression(state))
        if current(state)["type"] == "COMMA":
            advance(state)
    consume(state, "RPAREN")
    return stamp({"type": "NewInstance", "class_name": class_name, "args": args}, line)

task parse_self_expr(state):
    # self.attr            -> SelfAccess
    # self.attr = value    -> SelfAssign (consumes its own newline)
    # self.method(args)    -> MethodCall on the __self__ identifier
    line = current(state)["line"]
    consume(state, "SELF")
    consume(state, "DOT")
    attr = consume(state, "IDENTIFIER")["value"]

    if current(state)["type"] == "LPAREN":
        advance(state)
        let args = []
        while current(state)["type"] != "RPAREN":
            args.append(parse_expression(state))
            if current(state)["type"] == "COMMA":
                advance(state)
        consume(state, "RPAREN")
        return stamp({"type": "MethodCall",
                      "object": {"type": "Identifier", "name": "__self__"},
                      "method": attr, "args": args, "optional": false}, line)

    if current(state)["type"] == "ASSIGN":
        advance(state)
        value = parse_expression(state)
        expect_newline_or_eof(state)
        return stamp({"type": "SelfAssign", "attribute": attr, "value": value}, line)

    return stamp({"type": "SelfAccess", "attribute": attr}, line)

# ── async / await / stream think ────────────────────────────────────

task parse_async_function(state):
    line = current(state)["line"]
    consume(state, "ASYNC")
    # Accept both 'func' and 'task' after 'async'
    if current(state)["type"] == "FUNC":
        advance(state)
    elif current(state)["type"] == "TASK":
        advance(state)
    else:
        consume(state, "FUNC")  # trigger the normal error
    name = advance(state)["value"]  # allow keyword names

    # Reuses the same task-param parser regular/typed tasks use, so
    # async tasks get default values, *varargs, and type hints too.
    params = parse_task_param_list(state)

    return_type = null
    if current(state)["type"] == "ARROW":
        advance(state)
        return_type = consume(state, "IDENTIFIER")["value"]

    consume(state, "COLON")
    result = parse_block_with_docstring(state)
    docstring = result[0]
    body = result[1]

    return stamp({"type": "AsyncFunctionNode", "name": name, "params": params,
                  "body": body, "return_type": return_type,
                  "docstring": docstring}, line)

task parse_await_expr(state):
    # await <expr> — no trailing-newline handling here; relies on
    # the caller/enclosing block loop to mop it up, same as think_expr.
    line = current(state)["line"]
    consume(state, "AWAIT")
    expr = parse_expression(state)
    return stamp({"type": "AwaitNode", "expr": expr}, line)

task parse_stream_think(state):
    line = current(state)["line"]
    consume(state, "STREAM")
    consume(state, "THINK")
    prompt = parse_expression(state)
    consume(state, "COLON")
    skip_newlines(state)

    if current(state)["type"] == "INDENT":
        advance(state)

    consume(state, "EACH")
    chunk_var = consume(state, "IDENTIFIER")["value"]
    consume(state, "COLON")

    body = parse_block(state)

    if current(state)["type"] == "DEDENT":
        advance(state)

    return stamp({"type": "StreamThinkNode", "prompt": prompt,
                  "chunk_var": chunk_var, "body": body}, line)

# ── match / when / else ──────────────────────────────────────────────

MATCH_TYPE_NAMES = {"text": true, "number": true, "boolean": true,
                     "list": true, "dict": true, "any": true, "null": true}

task parse_inline_or_block(state):
    # After the colon of a when/else arm: an inline statement on the
    # same line, or a full indented block on subsequent lines.
    if current(state)["type"] == "NEWLINE":
        return parse_block(state)
    stmt = parse_statement(state)
    skip_newlines(state)
    if stmt != null:
        return [stmt]
    return []

task parse_match(state):
    line = current(state)["line"]
    advance(state)  # consume 'match'
    subject = parse_expression(state)
    consume(state, "COLON")
    skip_newlines(state)

    if current(state)["type"] == "INDENT":
        advance(state)

    arms = []

    while not at_end(state):
        skip_newlines(state)
        tok = current(state)

        if tok["type"] == "DEDENT" or tok["type"] == "EOF":
            break

        if tok["type"] == "ELSE":
            advance(state)
            consume(state, "COLON")
            body = parse_inline_or_block(state)
            arms.append({"type": "MatchArm", "pattern": null, "body": body, "is_else": true,
                        "is_type_check": false, "is_range": false, "range_end": null})
            skip_newlines(state)
            break  # else is always last

        if tok["type"] == "WHEN":
            advance(state)

            cur = current(state)
            is_type_check = false
            is_range = false
            range_end = null
            pattern = null

            if cur["type"] == "IDENTIFIER":
                name = cur["value"]
                next_type = peek_type(state, 1)
                starts_upper = len(name) > 0 and name[0] == name[0].upper()
                if MATCH_TYPE_NAMES.get(name, false) or (starts_upper and next_type == "COLON"):
                    is_type_check = true
                    pattern = name
                    advance(state)
                else:
                    pattern = parse_expression(state)
            else:
                pattern = parse_expression(state)

            # Range pattern: when 'a'..'z' or when 0..9
            if current(state)["type"] == "DOTDOT":
                advance(state)
                range_end = parse_expression(state)
                is_range = true

            consume(state, "COLON")
            body = parse_inline_or_block(state)
            arms.append({"type": "MatchArm", "pattern": pattern, "body": body, "is_else": false,
                        "is_type_check": is_type_check, "is_range": is_range,
                        "range_end": range_end})
            continue

        break  # anything unrecognised ends the match block

    if current(state)["type"] == "DEDENT":
        advance(state)

    return stamp({"type": "MatchStatement", "subject": subject, "arms": arms}, line)

# ── retry / observe ───────────────────────────────────────────────────

task parse_retry(state):
    line = current(state)["line"]
    consume(state, "RETRY")
    times = parse_expression(state)

    if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "times":
        advance(state)

    backoff = null
    if current(state)["type"] == "WITH":
        advance(state)
        if current(state)["type"] == "IDENTIFIER":
            strategy = advance(state)["value"].lower()
            if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "backoff":
                advance(state)
            backoff = strategy

    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)

    skip_newlines(state)

    fallback_body = null
    if not at_end(state) and current(state)["type"] == "FALLBACK":
        advance(state)
        consume(state, "COLON")
        expect_newline_or_eof(state)
        skip_newlines(state)
        fallback_body = parse_block(state)

    return stamp({"type": "RetryStatement", "times": times, "backoff": backoff,
                  "body": body, "fallback_body": fallback_body}, line)

task parse_observe(state):
    line = current(state)["line"]
    consume(state, "OBSERVE")
    label = parse_expression(state)

    tags = null
    if current(state)["type"] == "WITH":
        advance(state)
        if current(state)["type"] == "IDENTIFIER" and current(state)["value"] == "tags":
            advance(state)
        tags = parse_expression(state)

    consume(state, "COLON")
    expect_newline_or_eof(state)
    skip_newlines(state)
    body = parse_block(state)

    return stamp({"type": "ObserveStatement", "label": label, "tags": tags,
                  "body": body}, line)

# ── Identifier-led statements ──────────────────────────────────────

task parse_identifier_statement(state):
    line = current(state)["line"]
    name = consume(state, "IDENTIFIER")["value"]
    token = current(state)

    type_hint = null
    if token["type"] == "COLON":
        advance(state)
        if current(state)["type"] == "IDENTIFIER":
            type_hint = advance(state)["value"]
        token = current(state)

    augmented_ops = {"PLUS_EQUAL": "+", "MINUS_EQUAL": "-",
                      "STAR_EQUAL": "*", "SLASH_EQUAL": "/"}
    if augmented_ops.get(token["type"], null) != null:
        op = augmented_ops[token["type"]]
        advance(state)
        rhs = parse_expression(state)
        expect_newline_or_eof(state)
        expanded = {"type": "BinaryOp", "left": {"type": "Identifier", "name": name},
                    "operator": op, "right": rhs}
        return stamp({"type": "AssignStatement", "name": name, "value": expanded,
                      "type_hint": type_hint, "is_const": false,
                      "is_declaration": false}, line)

    if token["type"] == "ASSIGN":
        advance(state)

        # Captured think: thought = think "prompt" ...
        if current(state)["type"] == "THINK":
            node = parse_think(state)
            node["variable"] = name
            return stamp(node, line)

        # Captured parallel: results = autonomous parallel: ...
        if current(state)["type"] == "AUTONOMOUS":
            node = parse_autonomous(state)
            node["variable"] = name
            return stamp(node, line)

        # Captured pipeline run: result = run pipeline name
        if current(state)["type"] == "RUN":
            node = parse_run_pipeline(state)
            node["variable"] = name
            return stamp(node, line)

        if DEFERRED_AI_NATIVE_STATEMENT_TYPES.get(current(state)["type"], false):
            raise ("Captured '" + current(state)["type"] + "' expressions (" +
                   name + " = ...) are a later Layer 2 slice — not yet " +
                   "supported. Line " + str(line) + ".")
        value = parse_expression(state)

        # Captured pipeline: report = "prompt" -> agent1 -> agent2
        if current(state)["type"] == "ARROW":
            node = parse_pipeline(state, value)
            node["variable"] = name
            return stamp(node, line)

        expect_newline_or_eof(state)
        return stamp({"type": "AssignStatement", "name": name, "value": value,
                      "type_hint": type_hint, "is_const": false,
                      "is_declaration": false}, line)

    if token["type"] == "LBRACKET":
        advance(state)
        index = parse_expression(state)
        consume(state, "RBRACKET")
        if current(state)["type"] == "ASSIGN":
            advance(state)
            value = parse_expression(state)
            expect_newline_or_eof(state)
            return stamp({"type": "IndexAssignStatement",
                          "collection": {"type": "Identifier", "name": name},
                          "index": index, "value": value}, line)
        expr = {"type": "IndexExpression",
                "collection": {"type": "Identifier", "name": name}, "index": index}
        expr = apply_postfix(state, expr)
        expect_newline_or_eof(state)
        return expr

    if token["type"] == "LPAREN":
        call = finish_call(state, name)
        expect_newline_or_eof(state)
        return call

    if token["type"] == "DOT":
        expr = {"type": "Identifier", "name": name}
        expr = apply_postfix(state, expr)
        expect_newline_or_eof(state)
        return expr

    raise "Expected '=' or '(' after '" + name + "'. Line " + str(line) + "."

# ── Expression precedence chain ──────────────────────────────────

task parse_expression(state):
    expr = parse_ternary(state)
    while current(state)["type"] == "PIPE":
        line = current(state)["line"]
        advance(state)
        rhs = parse_ternary(state)
        expr = build_pipe_call(expr, rhs, line)
    return expr

task build_pipe_call(piped_value, rhs, line):
    if rhs["type"] == "CallExpression":
        rhs["args"] = [piped_value] + rhs["args"]
        return rhs
    if rhs["type"] == "Identifier":
        return {"type": "CallExpression", "name": rhs["name"],
                "args": [piped_value], "kwargs": {}}
    raise ("The right side of '|>' must be a task call or task name. Line " +
           str(line) + ".")

task parse_ternary(state):
    expr = parse_logical_or(state)
    if current(state)["type"] == "IF":
        line = current(state)["line"]
        advance(state)
        condition = parse_logical_or(state)
        if current(state)["type"] == "ELSE":
            advance(state)
            false_expr = parse_expression(state)
            return stamp({"type": "TernaryExpression", "condition": condition,
                          "true_expr": expr, "false_expr": false_expr}, line)
    return expr

task parse_logical_or(state):
    left = parse_logical_and(state)
    while current(state)["type"] == "OR":
        advance(state)
        right = parse_logical_and(state)
        left = {"type": "BinaryOp", "left": left, "operator": "or", "right": right}
    return left

task parse_logical_and(state):
    left = parse_comparison(state)
    while current(state)["type"] == "AND":
        advance(state)
        right = parse_comparison(state)
        left = {"type": "BinaryOp", "left": left, "operator": "and", "right": right}
    return left

task parse_comparison(state):
    left = parse_addition(state)
    comparison_ops = {"EQUALS": "==", "NOT_EQUALS": "!=", "LESS": "<",
                       "LESS_EQ": "<=", "GREATER": ">", "GREATER_EQ": ">="}

    while true:
        cur = current(state)
        op = comparison_ops.get(cur["type"], null)
        if op != null:
            advance(state)
            right = parse_addition(state)
            left = {"type": "BinaryOp", "left": left, "operator": op, "right": right}
        elif cur["type"] == "IN":
            advance(state)
            right = parse_addition(state)
            left = {"type": "BinaryOp", "left": left, "operator": "in", "right": right}
        elif cur["type"] == "NOT":
            saved = state["pos"]
            advance(state)
            if current(state)["type"] == "IN":
                advance(state)
                right = parse_addition(state)
                left = {"type": "BinaryOp", "left": left, "operator": "not in", "right": right}
            else:
                state["pos"] = saved
                break
        elif cur["type"] == "IDENTIFIER" and cur["value"] == "is":
            advance(state)
            if current(state)["type"] == "NOT":
                advance(state)
                right = parse_addition(state)
                left = {"type": "BinaryOp", "left": left, "operator": "is not", "right": right}
            else:
                right = parse_addition(state)
                left = {"type": "BinaryOp", "left": left, "operator": "is", "right": right}
        else:
            break

    return left

task parse_addition(state):
    left = parse_multiplication(state)
    while current(state)["type"] == "PLUS" or current(state)["type"] == "MINUS":
        op = current(state)["value"]
        advance(state)
        right = parse_multiplication(state)
        left = {"type": "BinaryOp", "left": left, "operator": op, "right": right}
    return left

task parse_multiplication(state):
    left = parse_unary(state)
    mul_types = {"MULTIPLY": true, "DIVIDE": true, "MODULO": true,
                 "POWER": true, "FLOOR_DIVIDE": true}
    while mul_types.get(current(state)["type"], false):
        op = current(state)["value"]
        advance(state)
        right = parse_unary(state)
        left = {"type": "BinaryOp", "left": left, "operator": op, "right": right}
    return left

task parse_unary(state):
    if current(state)["type"] == "MINUS":
        advance(state)
        return {"type": "UnaryOp", "operator": "-", "operand": parse_unary(state)}
    if current(state)["type"] == "NOT":
        advance(state)
        return {"type": "UnaryOp", "operator": "not", "operand": parse_unary(state)}
    return parse_primary(state)

# ── Primary expressions ────────────────────────────────────────────

task parse_primary(state):
    token = current(state)
    t = token["type"]

    if t == "INTEGER":
        advance(state)
        return {"type": "IntegerLiteral", "value": token["value"]}
    if t == "FLOAT":
        advance(state)
        return {"type": "FloatLiteral", "value": token["value"]}
    if t == "MONEY":
        advance(state)
        return {"type": "MoneyLiteral", "value": token["value"]}
    if t == "STRING":
        advance(state)
        return apply_postfix(state, {"type": "StringLiteral", "value": token["value"]})
    if t == "F_STRING":
        advance(state)
        return parse_fstring(token["value"])
    if t == "BOOLEAN":
        advance(state)
        return {"type": "BooleanLiteral", "value": token["value"]}
    if t == "NULL":
        advance(state)
        return {"type": "NullLiteral"}

    if t == "IDENTIFIER":
        advance(state)
        if current(state)["type"] == "LPAREN":
            expr = finish_call(state, token["value"])
        else:
            expr = {"type": "Identifier", "name": token["value"]}
        return apply_postfix(state, expr)

    if t == "LBRACE":
        return apply_postfix(state, parse_brace_literal(state))

    if t == "LBRACKET":
        return apply_postfix(state, parse_list(state))

    if t == "THINK":
        return parse_think_expr(state)

    if t == "RECALL":
        return parse_recall_expr(state)

    if t == "LISTEN":
        advance(state)
        prompt = null
        if current(state)["type"] == "STRING":
            prompt = {"type": "StringLiteral", "value": advance(state)["value"]}
        return {"type": "ListenExpression", "prompt": prompt}

    if t == "IMAGINE":
        return parse_imagine_expr(state)

    if t == "AWAIT":
        return parse_await_expr(state)

    if t == "NEW":
        return parse_new_instance(state)

    if t == "SELF":
        return parse_self_expr(state)

    if t == "LPAREN":
        advance(state)
        expr = parse_expression(state)
        if current(state)["type"] == "COMMA":
            elements = [expr]
            while current(state)["type"] == "COMMA":
                advance(state)
                if current(state)["type"] == "RPAREN":
                    break
                elements.append(parse_expression(state))
            consume(state, "RPAREN")
            return apply_postfix(state, {"type": "TupleLiteral", "elements": elements})
        consume(state, "RPAREN")
        return apply_postfix(state, expr)

    if DEFERRED_AI_NATIVE_STATEMENT_TYPES.get(t, false):
        raise ("'" + t + "' as an expression is Layer 2 work — not yet " +
               "supported. Line " + str(token["line"]) + ".")
    if DEFERRED_CLASS_TYPES.get(t, false):
        raise ("'" + t + "' (classes/self) is Layer 3 work — not yet " +
               "supported. Line " + str(token["line"]) + ".")

    raise ("Unexpected token '" + str(token["value"]) +
           "' while parsing an expression. Line " + str(token["line"]) + ".")

task apply_postfix(state, expr):
    while current(state)["type"] == "DOT" or current(state)["type"] == "LBRACKET" or current(state)["type"] == "QUESTION_DOT":
        if current(state)["type"] == "DOT":
            advance(state)
            prop = advance(state)["value"]
            if current(state)["type"] == "LPAREN":
                let args = parse_call_args(state)
                expr = {"type": "MethodCall", "object": expr, "method": prop,
                        "args": args, "optional": false}
            else:
                expr = {"type": "PropertyAccess", "object": expr,
                        "property": prop, "optional": false}
        elif current(state)["type"] == "QUESTION_DOT":
            advance(state)
            prop = advance(state)["value"]
            if current(state)["type"] == "LPAREN":
                let args = parse_call_args(state)
                expr = {"type": "MethodCall", "object": expr, "method": prop,
                        "args": args, "optional": true}
            else:
                expr = {"type": "PropertyAccess", "object": expr,
                        "property": prop, "optional": true}
        else:
            advance(state)  # consume '['
            expr = finish_index_or_slice(state, expr)
    return expr

task parse_call_args(state):
    consume(state, "LPAREN")
    let args = []
    while current(state)["type"] != "RPAREN":
        args.append(parse_expression(state))
        if current(state)["type"] == "COMMA":
            advance(state)
    consume(state, "RPAREN")
    return args

task finish_index_or_slice(state, obj):
    line = current(state)["line"]
    start = null
    if current(state)["type"] != "COLON" and current(state)["type"] != "RBRACKET":
        start = parse_expression(state)

    if current(state)["type"] == "COLON":
        advance(state)
        stop = null
        if current(state)["type"] != "RBRACKET" and current(state)["type"] != "COLON":
            stop = parse_expression(state)
        step = null
        if current(state)["type"] == "COLON":
            advance(state)
            if current(state)["type"] != "RBRACKET":
                step = parse_expression(state)
        consume(state, "RBRACKET")
        return stamp({"type": "SliceExpression", "obj": obj, "start": start,
                      "stop": stop, "step": step}, line)

    consume(state, "RBRACKET")
    return {"type": "IndexExpression", "collection": obj, "index": start}

task parse_list(state):
    consume(state, "LBRACKET")
    elements = []
    while current(state)["type"] != "RBRACKET":
        if at_end(state):
            raise "List was never closed — did you forget a ']'?"
        if current(state)["type"] == "ELLIPSIS":
            advance(state)
            elements.append({"type": "SpreadElement", "expr": parse_expression(state)})
        else:
            elements.append(parse_expression(state))
        if current(state)["type"] == "COMMA":
            advance(state)
    consume(state, "RBRACKET")
    return {"type": "ListLiteral", "elements": elements}

task parse_brace_literal(state):
    # Disambiguate {} / {k: v} (dict) from {a, b, c} (set), skipping
    # whitespace-only tokens the way the Python parser's lookahead does.
    skip_types = {"NEWLINE": true, "INDENT": true, "DEDENT": true}
    found = []
    i = state["pos"] + 1
    while i < len(state["tokens"]) and len(found) < 2:
        if not skip_types.get(state["tokens"][i]["type"], false):
            found.append(state["tokens"][i])
        i = i + 1

    first = null
    second = null
    if len(found) > 0:
        first = found[0]
    if len(found) > 1:
        second = found[1]

    if first == null or first["type"] == "RBRACE" or first["type"] == "ELLIPSIS":
        return parse_dict(state)
    if (first["type"] == "IDENTIFIER" or first["type"] == "STRING") and second != null and second["type"] == "COLON":
        return parse_dict(state)
    return parse_set(state)

task parse_set(state):
    consume(state, "LBRACE")
    elements = []
    skip_newlines(state)
    while current(state)["type"] != "RBRACE":
        if at_end(state):
            raise "Set was never closed — did you forget a '}'?"
        elements.append(parse_expression(state))
        if current(state)["type"] == "COMMA":
            advance(state)
        skip_newlines(state)
    consume(state, "RBRACE")
    return {"type": "SetLiteral", "elements": elements}

task parse_dict(state):
    consume(state, "LBRACE")
    pairs = []
    skip_newlines(state)

    while current(state)["type"] != "RBRACE":
        if at_end(state):
            raise "Dictionary was never closed."

        if current(state)["type"] == "ELLIPSIS":
            advance(state)
            pairs.append([{"type": "SpreadElement", "expr": parse_expression(state)}, null])
            if current(state)["type"] == "COMMA":
                advance(state)
            skip_newlines(state)
            continue

        if current(state)["type"] == "IDENTIFIER" or current(state)["type"] == "STRING":
            key = {"type": "StringLiteral", "value": advance(state)["value"]}
        else:
            raise "Dictionary key must be a word."

        consume(state, "COLON")

        while current(state)["type"] == "INDENT" or current(state)["type"] == "DEDENT" or current(state)["type"] == "NEWLINE":
            advance(state)

        value = parse_addition(state)
        pairs.append([key, value])

        if current(state)["type"] == "COMMA":
            advance(state)
        skip_newlines(state)

    consume(state, "RBRACE")
    return {"type": "DictLiteral", "pairs": pairs}

task finish_call(state, name):
    consume(state, "LPAREN")
    let args = []
    kwargs = {}
    while current(state)["type"] != "RPAREN":
        if current(state)["type"] == "IDENTIFIER" and peek_type(state, 1) == "ASSIGN":
            kw_name = consume(state, "IDENTIFIER")["value"]
            consume(state, "ASSIGN")
            kwargs[kw_name] = parse_expression(state)
        else:
            args.append(parse_expression(state))
        if current(state)["type"] == "COMMA":
            advance(state)
    consume(state, "RPAREN")
    return {"type": "CallExpression", "name": name, "args": args, "kwargs": kwargs}

# ── F-strings ─────────────────────────────────────────────────────
# Splits on {expr} placeholders with brace-depth counting (so nested
# f-strings work), then re-tokenizes/re-parses each expression via
# this same module — genuinely self-hosted, no host-language escape
# hatch.

task parse_fstring(raw):
    parts = []
    i = 0
    let length = len(raw)
    buf = ""

    while i < length:
        ch = raw[i]

        if ch != "{":
            buf = buf + ch
            i = i + 1
            continue

        if len(buf) > 0:
            parts.append(["str", buf])
            buf = ""

        depth = 1
        i = i + 1
        expr_src = ""

        while i < length and depth > 0:
            c = raw[i]
            if c == "{":
                depth = depth + 1
                expr_src = expr_src + c
            elif c == "}":
                depth = depth - 1
                if depth > 0:
                    expr_src = expr_src + c
            else:
                expr_src = expr_src + c
            i = i + 1

        expr_src = expr_src.strip()

        if len(expr_src) == 0:
            parts.append(["str", ""])
        else:
            try:
                inner_tokens = tokenize(expr_src)
                inner_state = new_parser_state(inner_tokens)
                expr_node = parse_expression(inner_state)
                parts.append(["expr", expr_node])
            catch:
                parts.append(["str", "{" + expr_src + "}"])

    if len(buf) > 0:
        parts.append(["str", buf])

    return {"type": "FStringLiteral", "parts": parts}

# ── Blocks ────────────────────────────────────────────────────────

task parse_block(state):
    if current(state)["type"] != "NEWLINE" and current(state)["type"] != "INDENT":
        stmt = parse_statement(state)
        if stmt != null:
            return [stmt]
        return []

    statements = []
    skip_newlines(state)

    if current(state)["type"] != "INDENT":
        raise ("Expected an indented block here. Did you forget to indent? Line " +
               str(current(state)["line"]) + ".")

    consume(state, "INDENT")
    skip_newlines(state)

    while not at_end(state) and current(state)["type"] != "DEDENT":
        stmt = parse_statement(state)
        if stmt != null:
            statements.append(stmt)
        skip_newlines(state)

    if current(state)["type"] == "DEDENT":
        consume(state, "DEDENT")

    return statements

task parse_block_with_docstring(state):
    docstring = null
    statements = []

    if current(state)["type"] != "NEWLINE" and current(state)["type"] != "INDENT":
        stmt = parse_statement(state)
        if stmt != null:
            return [docstring, [stmt]]
        return [docstring, []]

    skip_newlines(state)

    if current(state)["type"] != "INDENT":
        raise ("Expected an indented block here. Did you forget to indent? Line " +
               str(current(state)["line"]) + ".")

    consume(state, "INDENT")
    skip_newlines(state)

    if current(state)["type"] == "STRING" or current(state)["type"] == "F_STRING":
        docstring = current(state)["value"]
        advance(state)
        expect_newline_or_eof(state)
        skip_newlines(state)

    while not at_end(state) and current(state)["type"] != "DEDENT":
        stmt = parse_statement(state)
        if stmt != null:
            statements.append(stmt)
        skip_newlines(state)

    if current(state)["type"] == "DEDENT":
        consume(state, "DEDENT")

    return [docstring, statements]
