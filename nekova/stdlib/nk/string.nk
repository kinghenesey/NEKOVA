# ═══════════════════════════════════════════════════════════════
# NEKOVA Standard Library — string.nk
# Phase 18: String utilities written in NEKOVA
# ═══════════════════════════════════════════════════════════════

task str_repeat(s, n):
    result = ""
    i = 0
    while i < n:
        result = result + s
        i = i + 1
    return result

task pad_left(s, width, char=" "):
    s = str(s)
    while len(s) < width:
        s = char + s
    return s

task pad_right(s, width, char=" "):
    s = str(s)
    while len(s) < width:
        s = s + char
    return s

task truncate(s, max_len, suffix="..."):
    if len(s) <= max_len:
        return s
    return s[:max_len] + suffix

task is_empty(s):
    return len(s) == 0

task count_occurrences(s, sub):
    count = 0
    i = 0
    while i <= len(s) - len(sub):
        if s[i:i + len(sub)] == sub:
            count = count + 1
        i = i + 1
    return count

task capitalize(s):
    if len(s) == 0:
        return s
    return s[0].upper() + s[1:]

task reverse(s):
    return s[::-1]

task is_palindrome(s):
    rev = reverse(s.lower())
    return s.lower() == rev

task starts_with(s, prefix):
    return s[:len(prefix)] == prefix

task ends_with(s, suffix):
    return s[len(s) - len(suffix):] == suffix

task contains(s, sub):
    return sub in s

task wrap(s, width):
    words = s.split(" ")
    lines = []
    current = ""
    for word in words:
        if len(current) + len(word) + 1 > width and len(current) > 0:
            lines.append(current)
            current = word
        else:
            if len(current) == 0:
                current = word
            else:
                current = current + " " + word
    if len(current) > 0:
        lines.append(current)
    # Build result without .join() — concatenate with newlines manually
    result = ""
    i = 0
    while i < len(lines):
        if i == 0:
            result = lines[i]
        else:
            result = result + "\n" + lines[i]
        i = i + 1
    return result

task repeat(s, n):
    return str_repeat(s, n)
