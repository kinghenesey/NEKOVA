# ── Pattern Matching ──────────────────────────────
show "=== MATCH ==="

let status = 404
match status:
    when 200: show "OK"
    when 404: show "Not found"
    when 500: show "Server error"
    else: show f"Unknown: {status}"

let val = "hello"
match val:
    when text: show "got text"
    when number: show "got number"

# ── Database ──────────────────────────────────────
show "=== DATABASE ==="

let db = connect("test.db")
db.create("users", {"name": "text", "email": "text"})
db.insert("users", {"name": "Emmanuel", "email": "e@example.com"})
db.insert("users", {"name": "Alice", "email": "a@example.com"})

let users = db.query("users").all()
for user in users:
    show f"{user.id}: {user.name}"

let found = db.query("users").where("name", "Emmanuel").first()
show f"Found: {found.name}"

let total = db.count("users")
show f"Total: {total}"

db.close()